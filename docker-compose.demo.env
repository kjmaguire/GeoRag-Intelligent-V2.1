# =============================================================================
# docker-compose.demo.env — the values docker-compose.demo.yml cannot set itself
# =============================================================================
#
# Pass this as a SECOND --env-file, after your .env, so it wins:
#
#   docker compose -p <project-name> \
#     --env-file /abs/path/to/.env --env-file /abs/path/to/docker-compose.demo.env \
#     -f docker-compose.yml -f docker-compose.demo.yml \
#     --profile dev-light --profile dev-data up -d
#
# WHY A FILE AND NOT THE OVERLAY. docker-compose.yml interpolates these into
# `command:` (postgres -c shared_buffers=..., uvicorn --workers ...), which
# Compose does at PARSE time from the project environment: the shell, then
# --env-file, then .env. A service's `environment:` block is never consulted,
# so putting them there — as the overlay did — changed nothing inside the
# container and nothing in the command. And .env.example sets the 64 GB
# workstation values (8GB / 32GB / 192MB / 2GB / 6), so a demo box that copied
# it started Postgres with shared_buffers=8GB inside the overlay's 2G limit:
# it does not run slow, it fails to start.
#
# Check what the stack will really get before `up`:
#   docker compose <same flags as above> config | grep -E 'shared_buffers|--workers'
# =============================================================================

POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB

# Two workers is plenty for demo concurrency; each one multiplies the
# per-process footprint of fastapi.
UVICORN_WORKERS=2
