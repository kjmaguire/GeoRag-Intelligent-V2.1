<?xml version="1.0" encoding="UTF-8"?>
<!--
  phpunit.pgsql.xml — PostgreSQL-backed test run.

  Purpose: exercise Feature tests that cannot run under SQLite because they
  inspect PostGIS types, pg_catalog, information_schema, CHECK constraint
  definitions, MVT views, or use PostGIS functions (ST_X, ST_Transform, etc.)
  in controller queries. The default `phpunit.xml` forces SQLite with
  `force="true"` and these tests self-skip via `TestCase::skipIfSqlite()`.

  Target: the dedicated `georag_test` database on the `postgresql` service.
  Note that this config bypasses PgBouncer and connects to PG directly at
  postgresql:5432. PgBouncer is pinned to a single database (`georag`) and
  in transaction pooling mode, which can't handle RefreshDatabase's
  migrate:fresh workflow.

  The `georag_test` DB is provisioned by docker/postgresql/init/init-test-db.sh
  on first boot (or manually — see that script's header for the CLI recipe).

  Usage (from the host):
    docker exec georag-laravel-octane php artisan test -c phpunit.pgsql.xml

  Filter to one class (add `filter=CollarCrudTest` or similar).

  ⚠️  Safe to run freely: the `georag_test` DB is dedicated and contains no
  real data. RefreshDatabase tests re-create the schema on every run.

  See docs/RUNBOOK.md → "Test environment gotchas" for the full story on
  why `phpunit.xml`'s SQLite override beats the container's DB_CONNECTION.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <!--
          ORDER MATTERS: RefreshDatabase tests run first so their
          migrate:fresh populates georag_test before the read-only
          migration tests try to inspect information_schema / catalogs
          for tables and views they expect to exist.

          Without this ordering, the very first run against a freshly
          provisioned georag_test DB would see the read-only tests fail
          (schema empty) before RefreshDatabase had a chance to populate
          it.
        -->
        <testsuite name="Postgres (RefreshDatabase)">
            <!--
              RefreshDatabase tests that require real PostGIS (ST_X,
              ST_Transform, geometry columns). These run ONLY against
              georag_test — RefreshDatabase's migrate:fresh would drop
              every table.

              Maintenance note (2026-08-15): this list is hand-maintained
              rather than a <directory> glob over tests/Feature, because
              only a minority of the ~70 Feature test files actually need
              real Postgres — most run fine (and faster) on the default
              SQLite suite, and blanket-including all of them here would
              both balloon run time and risk exercising tests never
              verified against a real PG driver. When adding a new
              Postgres-dependent test, use `Tests\Concerns\RequiresPostgres`
              (or `TestCase::skipIfSqlite()`) so it self-identifies, then
              add it below — that trait/method is the audit signal:
                grep -rl "RequiresPostgres\|skipIfSqlite" tests/Feature
              A test that asserts real PG-only behavior (FK enforcement,
              pg_catalog/information_schema, RLS) without one of those
              guards will silently no-op or false-pass under the default
              SQLite suite — see CitationControllerIDORTest and
              WorkspaceRlsCoverageTest below, added without the trait
              because they're also meant to exercise belt-and-braces
              app-level filtering on SQLite; only their Postgres-only
              assertions are gated inline.
            -->
            <file>tests/Feature/Api/V1/CollarControllerTest.php</file>
            <file>tests/Feature/Api/V1/CollarCrudTest.php</file>
            <!-- Phase 3 / Step 3.2 — context envelope validation tests.
                 Uses RefreshDatabase + Project::factory(), so it runs
                 against PG (the silver.* migrations don't work on SQLite). -->
            <file>tests/Feature/Api/V1/QueryControllerContextEnvelopeTest.php</file>
            <!-- Reliability spec Phase 4 — per-run polling endpoint.
                 Locks T11 cross-workspace 404 contract. -->
            <file>tests/Feature/Api/V1/IngestProgressControllerTest.php</file>
            <!-- Reliability spec Phase 2 — broadcast controller side-effects:
                 data_version bump + refresh dispatch only on completed. -->
            <file>tests/Feature/Internal/IngestionProgressBroadcastControllerTest.php</file>
            <!-- Security fix 2026-08-14 (HIGH — cross-tenant IDOR) flagship
                 regression: CitationController's workspace-scoped resolver
                 paths. Needs real silver.workspaces rows + the
                 projects_workspace_id_fkey FK to actually be enforced;
                 SQLite's compat shim no-ops that FK so the fixture must
                 also run for real here. -->
            <file>tests/Feature/Api/V1/CitationControllerIDORTest.php</file>
            <!-- RLS second-pass fix 2026-08-15: PublicApiController::targets()
                 needs targeting.target_recommendations rows + the fail-closed
                 policy to actually be enforced, so the withWorkspaceRls() fix
                 (and its regression, an empty items[] for the rightful owner)
                 is only observable under real Postgres. -->
            <file>tests/Feature/Api/V1/PublicApiControllerTargetsTest.php</file>
            <file>tests/Feature/Api/V1/ChatConversationControllerIDORTest.php</file>
            <file>tests/Feature/Api/V1/CollarControllerIDORTest.php</file>
            <file>tests/Feature/Api/V1/ExportControllerIDORTest.php</file>
            <file>tests/Feature/Api/V1/PublicGeoscience/EntityReferencesControllerIDORTest.php</file>
            <!-- MIME-sniffing / bronze.source_files coverage — bronze schema
                 is Postgres-only (driver-gated migration). -->
            <file>tests/Feature/Api/V1/DrillUploadControllerTest.php</file>
            <file>tests/Feature/Admin/IntegrationsControllerTest.php</file>
            <file>tests/Feature/DecisionIntelligence/RecordDecisionTest.php</file>
            <file>tests/Feature/Foundry/IngestionRunsControllerTest.php</file>
            <file>tests/Feature/Internal/WorkspaceDataUpdatedBridgeControllerTest.php</file>
            <file>tests/Feature/Jobs/DebounceWorkspaceMvRefreshDataVersionTest.php</file>
            <file>tests/Feature/Services/AuditEmitterAlertBroadcastTest.php</file>
            <!-- Tenancy invariant backstop: every workspace-scoped table has
                 RLS + a policy, no legacy GUC, no chr(0) sentinel, no
                 fail-open escape hatch on the verified subset. Uses
                 RefreshDatabase to guarantee schema/policies are current. -->
            <file>tests/Feature/Tenancy/WorkspaceRlsCoverageTest.php</file>
            <!-- 2026-08-20 database review: pins audit.run_verification()'s
                 column + status-CHECK contract against the table, after a
                 *_for_test_db mirror migration defined a narrower table than
                 database/raw/ and won on every migration-chain-only cluster.
                 Must use RefreshDatabase — the bug is only reproducible in a
                 database built from migrations alone, which is exactly what
                 Azure is and what a hand-provisioned dev cluster is not. -->
            <file>tests/Feature/Tenancy/AuditVerificationSchemaContractTest.php</file>
            <file>tests/Feature/Database/RepairShadowDailySchemaTest.php</file>
            <!-- 2026-08-21 tenancy review: three more Postgres-gated files
                 that were never added. Two of them guard with an INLINE
                 `getDriverName() !== 'pgsql'` check rather than the
                 RequiresPostgres trait, so the audit grep documented above
                 could not see them — the detector, not just the list, was
                 the thing that had drifted. GuardSchemaRlsTest is the
                 pen-test for the five guard-arm tables (silver.query_traces,
                 data_quality_flags, document_versions, entity_aliases,
                 alias_gaps), none of which appear in the pgTAP file's nine,
                 so it was the only thing standing between a dropped FORCE
                 ROW LEVEL SECURITY and production — and it ran only in the
                 SQLite suite, where it always skipped.
                 PgsqlSuiteManifestTest now fails the build if this list
                 falls behind again. -->
            <file>tests/Feature/Tenancy/GuardSchemaRlsTest.php</file>
            <file>tests/Feature/Tenancy/BrokenChrZeroRlsPoliciesRoleTest.php</file>
            <!-- 2026-08-21: fail-closed RLS probe for the twelve tables
                 flipped by 2026_08_21_030000. Same georag_app SET ROLE
                 mechanism as BrokenChrZeroRlsPoliciesRoleTest above — it
                 must run here, because under the SQLite suite it skips. -->
            <file>tests/Feature/Tenancy/FailClosedRlsPolicyTest.php</file>
            <file>tests/Feature/Foundry/WorkspaceLithologyQueryCountTest.php</file>
            <!-- 2026-08-17 CI-gap audit: these RequiresPostgres files existed
                 but were never added here — grep -rl "RequiresPostgres\|
                 skipIfSqlite" tests/Feature turned up 7 files this config
                 was missing (see .github/workflows/ci.yml laravel job
                 comment for the full story on how they went undetected). -->
            <file>tests/Feature/Api/V1/ProjectControllerDeleteOrderingTest.php</file>
            <file>tests/Feature/Api/V1/PublicGeoscience/PublicGeoscienceMapControllerTest.php</file>
            <file>tests/Feature/Foundry/DrillholeDetailControllerTest.php</file>
            <file>tests/Feature/Foundry/WorkspaceCompareMergeTest.php</file>
            <file>tests/Feature/Foundry/IngestQualityControllerTest.php</file>
            <file>tests/Feature/Foundry/OverviewControllerTest.php</file>
            <!-- 2026-08-18: the Reader's "Indexed passages" tab had the
                 same dead bronze.provenance join SourcesControllerTest
                 was written for; ReportController was missed in that
                 2026-08-17 pass. -->
            <file>tests/Feature/Foundry/ReportControllerTest.php</file>
            <file>tests/Feature/Foundry/SourcesControllerTest.php</file>
            <!-- Deliberately last: does NOT use RefreshDatabase, asserts
                 against whatever project already exists after the
                 RefreshDatabase group above has run — see its own docblock. -->
            <file>tests/Feature/Foundry/WorkspaceThreeDPayloadTest.php</file>
        </testsuite>
        <testsuite name="Postgres (read-only)">
            <!--
              Strictly read-only tests that inspect schema/catalog only.
              Safe against any PG DB (including shared dev) because they
              never mutate application tables.
            -->
            <file>tests/Feature/Api/V1/PublicGeoscience/BedrockGeologyMigrationTest.php</file>
            <!-- Seeds/updates silver.entity_aliases directly (no
                 RefreshDatabase) and tears itself down; must run after the
                 RefreshDatabase group has populated the schema. -->
            <file>tests/Feature/Seeders/CgiVocabSeederTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>

        <!--
          2026-08-20: forced here, mirroring phpunit.xml, because this file
          was relying on .env.testing for it and that key decoded to 27 bytes
          — aes-256-cbc requires exactly 32. Every encryption-touching test
          threw:

              Unsupported cipher or incorrect key length. Supported ciphers
              are: aes-128-cbc, aes-256-cbc, aes-128-gcm, aes-256-gcm.

          That was 74 of the 215 cases in this suite, on every branch and on
          main, for long enough that nobody read the failure any more. A
          BLOCKING gate that is permanently red catches nothing, which is the
          real cost.

          .env.testing is fixed too, but this suite forces every other env it
          depends on rather than inheriting it, and APP_KEY should not have
          been the exception. Decodes to "phpunit-testing-key-not-a-secret".
        -->
        <env name="APP_KEY" value="base64:cGhwdW5pdC10ZXN0aW5nLWtleS1ub3QtYS1zZWNyZXQ=" force="true"/>

        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>

        <!--
          2026-08-17 CI-gap audit: IntegrationsController's sender-secret
          encryption (usage.register_external_notification_sender /
          lookup_..._secrets, both pgp_sym_encrypt/decrypt keyed on this
          value) requires AUDIT_ENCRYPTION_KEY to be set — it was never
          added here, so every IntegrationsControllerTest case that seeds
          or reads a sender either failed its own
          `AUDIT_ENCRYPTION_KEY must be configured` guard or 503'd via the
          controller's own `abort(503, 'AUDIT_ENCRYPTION_KEY not
          configured server-side')` check. Test-only value; unrelated to
          any real secret.
        -->
        <env name="AUDIT_ENCRYPTION_KEY" value="phpunit-pgsql-test-only-encryption-key-not-a-real-secret" force="true"/>

        <!--
          PostgreSQL connection — direct to the `postgresql` service,
          bypassing PgBouncer (which only knows about the `georag` DB and
          uses transaction pooling incompatible with migrate:fresh).
          Credentials match the committed dev defaults in .env.example.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="postgresql" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="georag_test" force="true"/>
        <env name="DB_USERNAME" value="georag" force="true"/>
        <!-- 2026-08-21 — placeholder, deliberately. Doc-phase 157 replaced
             this with the value read out of the running container via
             `docker exec georag-postgresql env`, to keep it "in sync". That
             put a live, in-use database password into a PUBLIC repository,
             in 25 tracked files. GitHub secret scanning did not catch it:
             push protection is on, but non-provider patterns are disabled,
             and a generic database password matches no provider pattern.

             No `force`, so DB_PASSWORD from the developer's own environment
             wins. Set it there (or in .env) if the local container uses
             something other than the .env.example default; do not paste a
             real credential back into this file. -->
        <env name="DB_PASSWORD" value="georag_dev_password"/>

        <!--
          2026-07-28 (#32) — several raw-SQL migrations (silver tenant
          isolation audit, drill-traces RLS policy drop, audit partition
          RLS, collar spatial uncertainty backfill) call
          `DB::connection('pgsql_migrations')` directly, independent of
          the `migrations.connection` config toggle. That connection's
          password (config/database.php) comes from MIGRATE_DB_PASSWORD,
          which this file never set — it silently defaulted to '', and
          RefreshDatabase's migrate:fresh failed with "fe_sendauth: no
          password supplied" the moment it hit one of those migrations.
          The main `pgsql` connection was never actually broken; only
          this second connection was missing credentials. Reuses the
          same DB_PASSWORD value above (same Postgres role/password).
        -->
        <env name="MIGRATE_DB_PASSWORD" value="georag_dev_password"/>

        <!--
          Expand search_path so RefreshDatabase's migrate:fresh can find
          and drop tables across all application schemas (dropAllTables
          scans every schema in the list). Without this override it falls
          back to `public` only and leaves silver.*, public_geoscience.*,
          etc. behind, and the re-migrate fails with "relation already
          exists".

          ORDER MATTERS: `public` must be first so unqualified CREATE
          TABLE (used by the base Laravel migrations) lands in public,
          matching the dev DB layout. Migrations that want silver/etc.
          already qualify explicitly (e.g., `silver.projects`).
        -->
        <env name="DB_SEARCH_PATH" value="public,silver,bronze,gold,index,public_geo,audit,ops,eval,targeting,interpretation,outbox,workspace,usage,workflow" force="true"/>

        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
