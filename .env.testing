APP_ENV=testing
# 32 bytes decoded — aes-256-cbc rejects anything else. The previous value
# ("testingkeyfortestingpurposesonly1234=") decoded to 27 and threw
# "Unsupported cipher or incorrect key length" for every encryption-touching
# test. Test-only; not a real secret.
APP_KEY=base64:cGhwdW5pdC10ZXN0aW5nLWtleS1ub3QtYS1zZWNyZXQ=

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
MAIL_MAILER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
