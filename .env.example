# =============================================================================
# GeoRAG Intelligence V1.0 — Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in all required values before running
# docker compose. Variables marked REQUIRED have no default and must be set.
# Variables marked RECOMMENDED should be changed from the default for anything
# beyond a first-run smoke test.
#
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -base64 32     (for passwords and keys)
#   php artisan key:generate --show    (for APP_KEY inside the container)
# =============================================================================


# =============================================================================
# APPLICATION SETTINGS
# Applies to: laravel-octane, laravel-horizon, laravel-reverb
# =============================================================================

APP_NAME="GeoRAG Intelligence"

# Environment: local | staging | production
APP_ENV=local

# REQUIRED — Laravel application encryption key.
# Generate with: php artisan key:generate --show
# Must be exactly 32 characters, base64-encoded: base64:...
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE

# Enable/disable debug mode. Must be false in production.
# Module 9 Chunk 9.7 — flipped default to false. Local-dev environments that
# want stack traces should override in their personal .env (NOT .env.example).
APP_DEBUG=false

# Module 9 Chunk 9.7 — reverse-proxy IP allowlist for X-Forwarded-* trust.
# Wildcard '*' is dev-friendly. Production should set the explicit CIDR of
# your nginx/Traefik front-end (e.g. '10.0.0.0/8' or '172.16.0.0/12').
# Security fix 2026-08-14: when APP_ENV=production and this is unset/empty,
# the app now fails CLOSED and trusts NO proxies (the old fallback was the
# '*' wildcard, which let clients spoof X-Forwarded-For). Non-production
# environments keep the '*' default.
TRUSTED_PROXIES=*

# Module 9 Chunk 9.6 — session cookie Secure flag. Defaults true outside
# local env via config/session.php logic. Override only if you know why.
# SESSION_SECURE_COOKIE=true

# Multi-tenant RBAC enforcement (FastAPI config.py).
# MULTI_TENANT_ENFORCEMENT_ENABLED=false requires SINGLE_TENANT_MODE=true — FastAPI
# will refuse to start if both are false (prevents accidental unenforced deployments).
# Dev default: enforcement off + single-tenant escape hatch on (no JWT workspace claims needed).
# Production: flip to MULTI_TENANT_ENFORCEMENT_ENABLED=true, SINGLE_TENANT_MODE=false.
MULTI_TENANT_ENFORCEMENT_ENABLED=false
SINGLE_TENANT_MODE=true

# Audit 2026-06-29 — Phase-2 strict tenancy (FastAPI agent hot path,
# app/agent/workspace_context.py). Default OFF = Phase-1 observe-only: a
# missing workspace_id on WorkspaceContext.from_state falls back to the
# legacy default-tenant UUID and increments
# metrics.WORKSPACE_RESOLUTION_FAILURES rather than failing. Flip to true
# to make it RAISE instead — do this only after that metric shows zero
# fallbacks for a sustained window, and before onboarding a 2nd workspace
# (every tenancy fix is latent until then).
# WORKSPACE_STRICT_TENANCY=true

# Public URL of the application (used for redirects, email links, asset URLs)
APP_URL=http://localhost

# Octane server port (host side)
# Host port for Laravel Octane. Default 80 often conflicts — use 8888 if so.
APP_PORT=8888

# Log verbosity: debug | info | warning | error | critical
LOG_LEVEL=debug

# Octane worker process settings — tune to your CPU core count
# Workstation (8-core): workers=4, task-workers=6 leaves headroom for other work
OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=6
OCTANE_MAX_REQUESTS=500


# =============================================================================
# POSTGRESQL / POSTGIS
# Applies to: postgresql, pgbouncer, laravel-*, fastapi, hatchet-worker
#
# Applications connect to PgBouncer (port 6432), NOT PostgreSQL directly (5432).
# PostgreSQL port 5432 is NOT exposed to the host.
# =============================================================================

# REQUIRED — database name, user, password
POSTGRES_DB=georag
POSTGRES_USER=georag
POSTGRES_PASSWORD=georag_dev_password

# PgBouncer host port (exposed to host for direct inspection with psql)
PGBOUNCER_PORT=6432

# GEORAG_APP_USER — non-superuser role that Laravel/FastAPI/Hatchet actually
# connect as (georag stays reserved for migrations/admin — see
# database/raw/phase1/10-georag-app-role.sql, R-P0-10 fix: georag is
# SUPERUSER/BYPASSRLS so RLS policies are silently ineffective on that
# connection). Defaults to georag_app in docker-compose.yml if unset here.
#
# REQUIRED — GEORAG_APP_PASSWORD has no default and must match the role's
# CREATE ROLE password on a fresh cluster — that script hardcodes
# 'georag-app-dev-replace-via-alter-role' as its initial password, so this
# default mirrors it exactly. Rotate both together via ALTER ROLE for any
# non-local deployment.
GEORAG_APP_USER=georag_app
GEORAG_APP_PASSWORD=georag-app-dev-replace-via-alter-role

# PostgreSQL performance tuning — Threadripper Pro 5955WX (16C/32T) +
# 64 GB RAM + RTX A4500 20 GB + 1.8 TB NVMe, single-purpose dev workstation.
# Hardware-refresh 2026-05-08: previous defaults (4 GB shared_buffers,
# 12 GB effective_cache_size, 8-core compose) were sized for an 8-core /
# shared-workstation era and left ~50 GB RAM unused. The dedicated box
# can reclaim it. See ops/baselines/capacity-planning.md.

# shared_buffers: ~12% of RAM. 8 GB is the working-set ceiling for our
# vector-aware query plans (HNSW prefetch + GIST index pages). Pushing
# higher hits diminishing returns since most reads land in OS page
# cache via effective_cache_size.
POSTGRES_SHARED_BUFFERS=8GB

# effective_cache_size: 50% of RAM. Single-tenant dev means the OS won't
# steal page cache from us. Was 12 GB; 32 GB lets the planner pick
# index-scan plans on warm tables far more aggressively.
POSTGRES_EFFECTIVE_CACHE_SIZE=32GB

# work_mem: per sort/hash operation. 192 MB for dev (was 128 MB). With
# 16 cores running max_parallel_workers=12, worst-case concurrent
# allocation is ~2.3 GB — well under the OS budget.
POSTGRES_WORK_MEM=192MB

# maintenance_work_mem: VACUUM / CREATE INDEX / CLUSTER. NVMe + 32-thread
# Threadripper handles 2 GB cleanly; index builds on the silver schema
# (pgTAP suite) drop ~40% with this bump.
POSTGRES_MAINTENANCE_WORK_MEM=2GB

# effective_io_concurrency: NVMe + Threadripper PCIe x16 lanes can sustain
# 256+ concurrent IO requests. Was 200 in the 8-core era; raise so
# bitmap heap scans on the geochem JSONB columns prefetch aggressively.
POSTGRES_EFFECTIVE_IO_CONCURRENCY=256

# max_worker_processes / max_parallel_workers / per_gather: tuned for the
# 16-core Threadripper. Was 8/8/4 in the 8-core compose; 24/12/6 lets
# Postgres parallelise the long-running silver-schema rollups + Dagster
# ingestion sweeps without starving the serving path's small queries.
POSTGRES_MAX_WORKER_PROCESSES=24
POSTGRES_MAX_PARALLEL_WORKERS=12
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=6
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=6


# =============================================================================
# REDIS 8
# Applies to: laravel-*, fastapi
#
# Used for: application cache, session storage, Horizon job queues.
# maxmemory 768 MB with volatile-lru on the dedicated dev workstation
# (512 MB before the 2026-05-08 hardware refresh; it was raised to 1 GB then,
# which is the whole of the 1G container — see REDIS_MAXMEMORY below).
# =============================================================================

REDIS_HOST=redis
# Host port for Redis. Default 6379 often conflicts with host Redis — use 6380 if so.
REDIS_PORT=6380

# Optional password — leave empty for no-auth (dev only, NOT for production)
REDIS_PASSWORD=georag_redis_dev

# Memory limit for the cache Redis instance. Keep it at or under 80% of
# whatever memory limit the container gets: Redis's cap covers its own
# dataset, while client buffers, fragmentation and the copy-on-write of
# every AOF rewrite sit on top of it. docker-compose.yml gives the redis
# container 1G, so 1gb here (the value this file carried) was equal to the
# limit: the kernel kills the container before Redis can evict anything,
# and volatile-lru below is never reached. 768mb is 75%. If you raise the
# container limit in docker-compose.yml, raise this with it.
REDIS_MAXMEMORY=768mb
# volatile-lru evicts only keys with a TTL — cache entries and sessions —
# and never a queued job, which has none. This instance holds all three.
REDIS_MAXMEMORY_POLICY=volatile-lru

# AOF (append-only file) persistence. "yes" gives ≤1s durability for Horizon
# queue jobs and sessions. Set to "no" for a pure cache instance.
REDIS_APPENDONLY=yes
# fsync policy: everysec = sync once per second (~5% perf cost, ≤1s data loss)
REDIS_APPENDFSYNC=everysec

# ── Prod 3-instance topology (staging/prod compose profiles only) ───────────
# Leave these unset for dev — Laravel falls back to REDIS_HOST/REDIS_PASSWORD.
# When set, they route cache / queue / sessions to dedicated Redis instances
# with role-appropriate eviction policies (allkeys-lru / noeviction /
# volatile-lru). See ops/runbooks/redis-topology.md and redis-3-instance-rollout.md.
#
# REDIS_CACHE_HOST=redis-cache
# REDIS_CACHE_PORT=6379
# REDIS_CACHE_PASSWORD=
# REDIS_CACHE_DB=0
#
# REDIS_QUEUE_HOST=redis-queue
# REDIS_QUEUE_PORT=6379
# REDIS_QUEUE_PASSWORD=
# REDIS_QUEUE_DB=0
#
# REDIS_SESSION_HOST=redis-sessions
# REDIS_SESSION_PORT=6379
# REDIS_SESSION_PASSWORD=
# REDIS_SESSION_DB=0
#
# Routing flags — set these in .env.staging / .env.prod alongside the hosts
# above. Without them set, Laravel uses the default single Redis instance.
# SESSION_CONNECTION=sessions
# REDIS_CACHE_CONNECTION=cache
# REDIS_QUEUE_CONNECTION=queue
#
# Corrected 2026-09-29 (LAR-17): this block also said
# `HORIZON_REDIS_CONNECTION=queue`. Do NOT set that. Horizon's supervisor
# `connection` names a QUEUE connection (config/queue.php → connections),
# not a Redis connection, and `queue` exists only in config/database.php →
# redis. Following the old line made Horizon fail with "queue connection
# [queue] not configured". The one switch that moves jobs onto the dedicated
# Redis connection is REDIS_QUEUE_CONNECTION=queue above: the `redis` queue
# connection (which Horizon already uses) then reads the `queue` Redis
# connection. tests/Unit/Config/QueueConnectionCoherenceTest.php pins this.
#
# As built in AWS: REDIS_QUEUE_CONNECTION is NOT set, so jobs ride the
# `default` Redis connection. Both resolve to the same host, port, password
# and DB 0 there (REDIS_QUEUE_HOST/REDIS_QUEUE_DB are unset too), so setting
# it would change the keyspace of nothing — it is documentation drift, not
# an outage. Redis in production runs volatile-lru, which is what protects
# the TTL-less queue keys, not the connection name.

# ── Optional dev keyspace isolation (single Redis instance) ────────────────
# Even on a single dev Redis (--databases 4), you can opt into per-role
# keyspace isolation by activating these. With both set, sessions land on
# DB 3 instead of sharing DB 0 with Horizon queues. Same physical instance,
# same allkeys-lru, but keyspaces no longer collide on FLUSHDB / triage.
#
# Trade-off: existing sessions are wiped on cutover (TTL'd anyway, ≤ 2 hr
# session lifetime in this app). Uncomment after first session-loss is
# acceptable.
#
# SESSION_CONNECTION=sessions
# REDIS_SESSION_DB=3


# =============================================================================
# QDRANT v1.17 — vector database
# Applies to: qdrant, fastapi, hatchet-worker
#
# HNSW m=16, ef_construct=200 are set at the service level.
# Per-collection overrides (payload indices, quantization) are applied by
# the FastAPI service on collection creation.
# =============================================================================

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Optional API key for Qdrant. Leave empty to disable auth (dev — network
# isolation is the threat model). Set in a docker-compose.override.yml to
# enable: QDRANT__SERVICE__API_KEY must also be set in the qdrant service.
# See docs/RUNBOOK.md "Qdrant access control".
QDRANT_API_KEY=


# =============================================================================
# MINIO — S3-compatible object storage
# Applies to: minio, minio-init, laravel-*, fastapi, hatchet-worker
#
# Bronze layer: immutable raw file archive (drill logs, PDFs, geophysics).
# S3 API port: 8333  |  Filer / admin web UI: 8890 on the host (8888 inside
# the container; 8888 on the host is Laravel's APP_PORT, set near the top).
# =============================================================================

# REQUIRED — root credentials for the S3-compatible object store.
# (Variable names keep the MINIO_ prefix for backward compat with code that
# already references them. The actual backend is now SeaweedFS — see
# docs/adr/0001-seaweedfs-replaces-minio.md.)
MINIO_ROOT_USER=georag-admin
MINIO_ROOT_PASSWORD=georag_minio_dev

# Ports exposed to host. Under SeaweedFS the S3 API listens on 8333 (was 9000
# under MinIO); the filer/admin HTTP UI listens on 8888 in the container (no
# separate console) and is published on host port 8890, because APP_PORT=8888
# already takes 8888 on the host and a second bind fails with "port is already
# allocated" when dev-light and dev-data start together.
MINIO_API_PORT=8333
MINIO_CONSOLE_PORT=8890

# Internal endpoint (service-to-service). Laravel and FastAPI use this URL.
MINIO_ENDPOINT=http://minio:8333

# Bucket names — created automatically by the minio-init container, and also
# auto-created by SeaweedFS on first PUT.
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_BRONZE_RASTER=bronze-raster

# ── Object storage backend selection ────────────────────────────────────
# STORAGE_BACKEND picks the georag_object_storage implementation, and
# "s3_compatible" is now the only value it accepts: the MINIO_* vars above in
# dev (SeaweedFS/MinIO), AWS S3 in production, same driver either way.
#
# "azure_blob" was the second value from 2026-07 until ADR-0022 retired it on
# 2026-09-08. factory.py raises on it rather than dispatching to it, and the
# six AZURE_STORAGE_* variables that configured it were deleted from this file
# on 2026-09-16 — they had no reader left anywhere in the tree, so leaving
# them here described a backend that would refuse to start.
STORAGE_BACKEND=s3_compatible


# ── MapLibre basemap style URLs (frontend) ──────────────────────────────────
# CLAUDE.md hard rule #8: MapLibre GL (not Mapbox GL) for on-prem licensing.
# Each style URL is independently overridable so air-gapped deployments can
# point at a self-hosted style.json. Defaults are public CDNs requiring no
# API key — fine for cloud/dev, replace for on-prem.
# See config/services.php (basemap.styles) and resources/js/lib/basemap.ts.
# MAPLIBRE_STYLE_POSITRON=https://tiles.openfreemap.org/styles/positron
# MAPLIBRE_STYLE_BRIGHT=https://tiles.openfreemap.org/styles/bright
# MAPLIBRE_STYLE_DARK_MATTER=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Qwen thinking mode — DEFAULT FOR FREE-TEXT-ONLY callers.
# All grounded-synthesis call sites and every structured/JSON endpoint pass
# enable_thinking=False explicitly at the call site (TOOL-CALL-01 fix).
# This env var only changes the fallback for callers that don't pass an
# explicit value — i.e. exploratory / classifier-escalation paths.
# FALSE (default): safe-by-default, conserves the answer-token budget.
# TRUE: free-text chat may use <think>...</think> reasoning traces.
# Renamed from ENABLE_THINKING (true-default) to make scope explicit —
# see docs/model_migration.md.
ENABLE_THINKING_FREE_TEXT_DEFAULT=false

# Qwen3 sampling parameters — Qwen team's published recommendations.
# Two regimes branch off these in the orchestrator:
#   thinking ON  : temperature=0.7, top_p=0.8, top_k=20, min_p=0
#   thinking OFF : temperature=0.7, top_p=0.8, top_k=20, presence_penalty=1.5
# Override individually if your golden-set sweep finds a better local optimum.
QWEN3_TOP_P=0.8
QWEN3_TOP_K=20
QWEN3_MIN_P=0.0
QWEN3_PRESENCE_PENALTY_NO_THINK=1.5

# MoE review (2026-05-08, item #5): JSON / structured output paths use a
# separate (lower) presence_penalty so the model isn't penalised for
# repeating necessary structural tokens (`{`, `}`, field names). 0.0 is
# the OpenAI-compat default. Raise toward 0.5 only if structured outputs
# show repetition loops in production. Activated by passing
# response_format="json" on `_call_openai_compatible_llm` / `_call_llm`.
QWEN3_PRESENCE_PENALTY_STRUCTURED=0.0

# =============================================================================
# LANGFUSE / LANGGRAPH (v1.15 prep — agentic orchestration upgrade)
# Applies to: fastapi (when uv sync --extra langgraph), claude_desktop_config.json,
#             docker/compose.langfuse.yml overlay
#
# Langfuse is the self-hosted, Apache-2.0 agent-trace backend used during
# the LangGraph migration (per ADR-0002 orchestration boundaries — to be
# formalised). Chosen over LangSmith because:
#   * Apache 2.0, no SaaS lock-in
#   * Self-hostable on the existing GeoRAG stack (Postgres + Redis + S3 reused;
#     adds ClickHouse for OLAP traces + 2 Langfuse processes)
#   * Aligns with the air-gapped junior-mining on-prem target
#   * Free for local dev (Cloud free tier also works for SaaS-curious devs)
#
# Bring-up:
#   1. Generate the secrets below (openssl rand -base64 32 / -hex 32)
#   2. docker compose -f docker-compose.yml -f docker/compose.langfuse.yml up -d
#   3. Open http://localhost:3001, sign up (or use the LANGFUSE_INIT_* env
#      vars below to bootstrap a user without going through the UI)
#   4. Settings → API Keys → Create new API key
#   5. Copy the pk-lf-... + sk-lf-... values into claude_desktop_config.json
# =============================================================================

# ----- Self-host service env (consumed by docker/compose.langfuse.yml) -----

# Host port where the Langfuse UI binds (avoid clash with Reverb on 8085).
LANGFUSE_HOST_PORT=3001

# Public URL the Langfuse cookie + email-link flow expects. Set to your
# external hostname when fronting via the Laravel reverse proxy.
LANGFUSE_NEXTAUTH_URL=http://localhost:3001

# Langfuse's own database lives inside the existing georag-postgresql
# instance. Created on first boot by the langfuse-init job in the overlay.
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse_user
# Generate via: openssl rand -base64 24
LANGFUSE_DB_PASSWORD=

# ClickHouse — mandatory new dependency for Langfuse v3 OLAP trace store.
# `langfuse` is the role; the database is created automatically by Langfuse
# migrations on first boot.
CLICKHOUSE_USER=langfuse
# Generate via: openssl rand -base64 24
CLICKHOUSE_PASSWORD=

# S3 buckets in SeaweedFS (georag-minio). Created by Langfuse on first
# write — the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY values from the
# main S3 config block (above) are reused.
LANGFUSE_S3_EVENT_BUCKET=langfuse-events
LANGFUSE_S3_MEDIA_BUCKET=langfuse-media

# Auth + crypto. ROTATING SALT OR ENCRYPTION_KEY INVALIDATES EVERY
# STORED API KEY AND PROJECT CREDENTIAL — commit to your secret store
# and never rotate without a migration plan.
# Generate via:
#   openssl rand -base64 32        # LANGFUSE_NEXTAUTH_SECRET
#   openssl rand -hex 32           # LANGFUSE_SALT
#   openssl rand -hex 32           # LANGFUSE_ENCRYPTION_KEY
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# Optional first-user bootstrap — leave blank to use the UI sign-up flow.
# Useful for fresh / CI installs where you want a known admin.
LANGFUSE_INIT_ORG_NAME=GeoRAG
LANGFUSE_INIT_PROJECT_NAME=georag-dev
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ----- Tracing client config (consumed by FastAPI / LangGraph) -----

# When true, the LangGraph migration's in-process tracer ships traces to
# Langfuse. Off by default to avoid leaking traces during local-only
# debugging; flip on in staging/prod via the relevant compose overlay.
LANGFUSE_TRACING=false

# API endpoint for the tracing client. Use the internal docker hostname
# when FastAPI ships traces in-process (preferred), or localhost:3001
# when running outside Docker. Set to https://cloud.langfuse.com for the
# Cloud free tier instead of self-host.
LANGFUSE_HOST=http://langfuse-web:3000

# API keys — generated AFTER first sign-in via Langfuse UI → Settings →
# API Keys → Create. The pk-lf-... is public, sk-lf-... is secret;
# both are required by the SDK.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Project tag in Langfuse traces — matches what the UI displays.
LANGFUSE_PROJECT=georag-dev


# =============================================================================
# LLM CONFIGURATION
# Applies to: fastapi
#
# Backends — select via LLM_BACKEND:
#   cohere     (default)         → Cohere's own API, Command A+ over
#                                  POST /v2/chat with COHERE_API_KEY.
#                                  Cutover 2026-09-15 (ADR-0023).
#   bedrock    (optional)        → Amazon Bedrock, Cohere Command A+
#                                  through the Converse API. Requires
#                                  BEDROCK_* below. Was the default from
#                                  2026-09-08 (ADR-0022) until ADR-0023
#                                  found Command A+ is an AWS Marketplace
#                                  SageMaker package, not a Bedrock model:
#                                  A100/H100 instances that bill whether or
#                                  not anything calls them. Still selectable
#                                  if you deploy the endpoint anyway.
#   vllm       (legacy/optional)  → An OpenAI-compatible endpoint (vLLM or
#                                  equivalent) you run yourself. The local
#                                  `vllm` compose service was removed —
#                                  point VLLM_URL at an external instance.
#   anthropic  (optional fallback) → Claude API (native SDK; unlocks prompt
#                                  caching, adaptive thinking, priority
#                                  tier, the 300k-output batch beta).
#
#   azure      RETIRED 2026-09-08 — a STARTUP ERROR naming its replacement,
#                                  not a fallback. Settings rejects it, and
#                                  rejects any leftover AZURE_FOUNDRY_*
#                                  variable, because a stale value is
#                                  well-formed settings pointing at a
#                                  resource that no longer exists: without
#                                  the hard failure the service starts
#                                  clean and dies at the first query.
#
# Note that Bedrock has NOT left the stack: reranking (Cohere Rerank 3.5)
# still goes there under RERANKER_BACKEND, a separate variable from this
# one. Embeddings left it on 2026-10-04 (ADR-0025): the code default for
# EMBEDDING_BACKEND is now `cohere` (Embed 5 on Cohere's own API, sharing
# COHERE_API_KEY with chat and Parse); `bedrock` (Embed v4) stays as the
# rollback.
#
# Context budgets (MAX_CONTEXT_*) default to sane values for the legacy
# vLLM path's working window. When using LLM_BACKEND=cohere, bedrock or
# anthropic (all much larger context windows), raise MAX_CONTEXT_TOKENS and
# the per-category caps 5-10× to ground synthesis queries on the full corpus
# of retrieved data — see COHERE_CHAT_MAX_MODEL_LEN /
# MAX_CONTEXT_TOKENS_BEDROCK in app/config.py. (`cohere` and `bedrock` share
# that budget because they share a model and therefore a context window.)
# =============================================================================

# Which backend the FastAPI orchestrator calls for the summary LLM call.
# Options: cohere | bedrock | vllm | anthropic
LLM_BACKEND=cohere

# There is no automatic fallback to another backend: a failed or
# rate-limited call is retried on the SAME backend (llm_common.py) and then
# surfaces as an error. (A LLM_BACKEND_FALLBACK setting with downshift /
# local_llm / off modes used to be documented here; nothing implements it.)

# Primary backend URL — only used when LLM_BACKEND=vllm.
# Empty by default: `http://vllm:8000` named the compose service deleted
# on 2026-07-30. Set it only if you run an OpenAI-compatible endpoint.
LLM_PRIMARY_URL=

# Model name sent to the primary backend when LLM_BACKEND=vllm.
LLM_PRIMARY_MODEL=Qwen/Qwen3-14B-AWQ

# ── Cohere API backend (Cohere Command A+) ──────────────────────────────
# Only used when LLM_BACKEND=cohere (the default since ADR-0023). Same
# model as the bedrock block below, different host: no endpoint to stand
# up, no idle cost, billed per token.
#
# In production this is read from Secrets Manager and must be written there
# BEFORE the first terraform apply — ECS refuses to start a task that
# references a secret key which does not exist, and the failure presents as
# a task that never starts rather than as an application error.
#
# ⚠️ WIRE SHAPE UNVERIFIED. Written to Cohere's documented v2 contract and
# not yet confirmed by a live call from this codebase. The load-bearing
# assumption is that `response_format: {"type": "json_object"}` is honoured,
# because every typed-output guard in orchestrator_validators.py depends on
# it. app/agent/llm_cohere.py lists the rest.
COHERE_API_KEY=

# Override for a proxy or a private deployment. Leave as-is otherwise.
COHERE_BASE_URL=https://api.cohere.com
COHERE_CHAT_MODEL=command-a-plus-05-2026

# Context window ceiling — 128K in / 64K out for Cohere Command A+. Must
# match reality or requests near the ceiling get 400s from the provider
# instead of clean local truncation.
COHERE_CHAT_MAX_MODEL_LEN=128000
COHERE_CHAT_MAX_TOKENS=8192
# Cap on the model's reasoning tokens (spent from MAX_TOKENS before the
# answer). >0 caps it, 0 turns reasoning off, -1 sends nothing (uncapped).
COHERE_CHAT_THINKING_BUDGET=1024

# Read timeout for one generation. There is no cold start on this host —
# that was a Marketplace-endpoint concern — so this is sized for a long
# grounded answer, not for a container coming up.
COHERE_CHAT_TIMEOUT_S=120

# ── Amazon Bedrock backend (Cohere Command A+) ──────────────────────────
# Only used when LLM_BACKEND=bedrock. There is no endpoint
# and no API key here: boto3's credential chain authenticates every call
# with SigV4 (an ECS task role in production; your usual local AWS profile
# or SSO session in dev), so there is nothing here to rotate or leak.
#
# Region is separate because the Bedrock model catalogue varies by region,
# and the models this stack needs may not live where the rest of it does.
BEDROCK_REGION=us-east-1

# Cohere Command A+. Bedrock's SERVERLESS Cohere generative catalogue is
# Command R/R+, which is NOT the model this stack runs, so this is the ARN
# of a Bedrock Marketplace / SageMaker-managed endpoint that bills for as
# long as it exists. Leave it empty unless you have actually deployed one:
# ADR-0023 found the instance classes (A100/H100) uneconomic and moved the
# default to `cohere`, which needs none of this.
#
# ⚠️ The three Foundry chat behaviours confirmed live on 2026-07-30 — JSON
# response_format support, a separate reasoning_content field, and Cohere's
# <|START_TEXT|>/<|END_TEXT|> sentinel wrapping on JSON output — were NOT
# re-verified on Bedrock. The adapter strips the sentinels unconditionally
# and handles both reasoning shapes, so it tolerates either; run
# ops/validation/bedrock_probe.py to replace tolerance with knowledge.
BEDROCK_CHAT_MODEL_ID=

# Context window ceiling — 128K in / 64K out for Cohere Command A+. Must
# match reality or requests near the ceiling get 400s from Bedrock instead
# of clean local truncation.
BEDROCK_CHAT_MAX_MODEL_LEN=128000
BEDROCK_CHAT_MAX_TOKENS=4096

# A Marketplace endpoint that has just been created is cold, not broken, on
# its first call. This is the ceiling before that counts as a failure.
BEDROCK_CHAT_COLD_START_TIMEOUT_S=120

# ── Reranker backend (Cohere Rerank on Amazon Bedrock) ──────────────────
# RERANKER_BACKEND options: bedrock (CODE DEFAULT since 2026-09-08 — Cohere
# Rerank, no local model at all) | cross_encoder (self-hosted
# Qwen3-Reranker-0.6B; the dev-stack value below) | qwen3_causal (opt-in,
# GPU sidecar). `foundry` is REJECTED at startup, not ignored.
#
# ⚠️ VERSION REGRESSION. Foundry served Rerank **v4**; Bedrock's catalogue
# is Rerank **3.5**. RERANKER_SCORE_THRESHOLD_HOSTED (renamed from
# _FOUNDRY) was measured against v4 and is the only retrieval-quality gate
# in the system — carried over UNVALIDATED. Not a golden-set job: that set
# has no chunk-level relevance labels. See app/services/reranker.py.
#
# Bedrock reranking is the `bedrock-agent-runtime` Rerank API, NOT
# InvokeModel and NOT Cohere's own /v2/rerank surface; scores come back as
# `relevanceScore`, not `relevance_score`. See app/services/reranker.py.
RERANKER_BACKEND=cross_encoder
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
BEDROCK_RERANK_TIMEOUT_S=8.0
# Interactive retry profile, deliberately tighter than the ingestion
# ceiling of 4. botocore's adaptive mode supplies the delays.
BEDROCK_RERANK_MAX_ATTEMPTS=3

# ── Embedding backend (Cohere Embed 5 on Cohere's API; dev uses the sidecar) ─
# EMBEDDING_BACKEND options: cohere (CODE DEFAULT since 2026-10-04, ADR-0025 —
# Cohere Embed 5 on Cohere's own API, no local model at all, needs
# COHERE_API_KEY) | bedrock (Cohere Embed v4 on Bedrock, the rollback) | local
# (self-hosted Qwen3-Embedding-0.6B; the dev-stack value below, which is why
# this file sets it explicitly rather than inheriting the hosted default).
# `foundry` is REJECTED at startup, not
# ignored — on a host with no embedding sidecar, falling through silently
# would mean a query path that retrieves nothing while reporting success.
#
# The setting covers both the FastAPI query path and the Hatchet ingestion
# path in passage_embedder.py; set it on both services in
# docker-compose.yml, identically, or the two write vectors from different
# models into the same collection.
#
# output_dimension=1024 matches the georag_chunks collection exactly
# (Matryoshka truncation — Embed 5 Pro supports 256/512/768/1024/1536/2048,
# Embed v4 256/512/1024/1536), so there is no Qdrant schema migration. A
# full re-embed is still mandatory when switching (dims matching does not
# make two models' vector spaces the same; use
# src/fastapi/scripts/reset_embeddings_for_reencode.py --all).
#
# See app/services/embedding.py for the full contract, including the
# input_type="search_document"/"search_query" asymmetry Cohere
# recommends (handled automatically — ingestion uses the default,
# query-time call sites use the dedicated embed_query() method).
EMBEDDING_BACKEND=local
# Only read when EMBEDDING_BACKEND=cohere (ADR-0025). COHERE_EMBED_QUERY_MODEL
# defaults to COHERE_EMBED_MODEL; leave it unset until the probe's Pro-vs-Fast
# measurement says embed-v5.0-fast is safe for queries. COHERE_EMBED_DIMENSION
# must equal EMBEDDING_DIMENSION or startup fails.
COHERE_EMBED_MODEL=embed-v5.0-pro
COHERE_EMBED_DIMENSION=1024
COHERE_EMBED_TIMEOUT_S=30
# Only read when EMBEDDING_BACKEND=bedrock (the Embed v4 rollback).
BEDROCK_EMBED_MODEL_ID=cohere.embed-v4:0
BEDROCK_EMBED_DIMENSION=1024
BEDROCK_EMBED_TIMEOUT_S=30

# Embed batch concurrency — how many embedding batches
# passage_embedder.py runs in flight at once during ingestion. Read
# straight from the environment (code-level fallback is 3 when unset);
# the live stack runs 4.
EMBED_CONCURRENCY=4

# ── Remote OCR engine: Cohere Parse on Cohere's API (ADR-0019/0022/0023) ─
# Replaced Azure Document Intelligence on 2026-09-02, moved Foundry →
# Bedrock on 2026-09-08, and Bedrock → Cohere's own API on 2026-09-15.
# Parse is a vision-language document parser; the MODEL has not changed
# across any of it, only the host.
#
# It uses COHERE_API_KEY, the same key as LLM_BACKEND=cohere — one
# credential for both capabilities. Leave it empty to develop on tesseract
# only. There is no endpoint to stand up and nothing billing while idle;
# ADR-0023 moved it because the Marketplace endpoint was ~$2.50/hour just
# to exist.
#
# The selector is the exact string `cohere_parse`. Retired values
# (`azure_document_intelligence`, and now the Foundry deployment variable)
# are logged at CRITICAL and run tesseract — the engine never silently
# selects something else. Unset = cohere_parse (since 2026-10-04, same rule as
# EMBEDDING_BACKEND: the unset value is the hosted one production runs). A
# worker with no COHERE_API_KEY logs ONE CRITICAL per process and runs
# tesseract, so the default is fail-safe. An air-gapped site sets
# OCR_ENGINE=tesseract explicitly (and, with it, PDF_PARSE_MODE degrades to
# ocr_only). Set it explicitly everywhere anyway (docker-compose does).
#
# The Parse wire contract has NEVER been empirically verified — true on
# Foundry, true on Bedrock, still true here. Run the probe with a real key
# and update app/services/ingest/cohere_parse_client.py from its report
# before trusting the adapter's request shape. The contract as data is in
# app/services/cohere_wire.py.
#
# What Parse does NOT return: per-word confidence or word polygons. Its
# pages persist ocr_confidence = NULL (ocr_method='cohere_parse' is the
# discriminator) and the quality router scores them on content signals
# only — see OCR_ROUTING_THRESHOLDS_JSON below. Oversized plan sheets are
# DOWNSCALED to COHERE_PARSE_MAX_PIXELS, not tiled (no polygons to stitch
# tiles back together); a warning is logged when that costs resolution.
OCR_ENGINE=cohere_parse

# Cohere's own model name for Parse v5. A plain name, not an endpoint ARN.
COHERE_PARSE_MODEL=parse-v5.0
# The key is COHERE_API_KEY, set once in the LLM section above.

# Per-request timeout. One page image per request.
COHERE_PARSE_TIMEOUT_S=120

# Pixel ceiling for the rendered page image. Pages up to ~tabloid hit the
# 200 DPI render ceiling first; at 20 MP an A1 plan sheet renders at ~158 DPI
# and an A0 at ~112 DPI (4 MP gave A0 ~50 DPI). An over-cap request fails as
# a 4xx and the page falls back to tesseract, so a too-high value is loud,
# not silent. 20 MP was accepted live on 2026-09-24 (cohere_probe report).
COHERE_PARSE_MAX_PIXELS=20000000

# ── Terrain model for collars with no elevation (hatchet-worker) ──────────
# promote_silver_to_gold looks the ground height up for any collar whose file
# had no elevation and stores it in silver.collars.elevation_dem_m (the file's
# own `elevation` always wins). Default: Copernicus GLO-30 (~30 m, metres
# above the EGM2008 geoid) from the public AWS Open Data bucket — no key, but
# it needs egress. EMPTY turns the lookup off (air-gapped sites); a local
# mirror works too. {tile} = Copernicus tile name. See
# src/fastapi/app/services/dem_elevation.py.
# Privacy: reading a tile by HTTP range request tells the bucket operator
# which 1-degree tile and which ~28 km blocks of it were read, i.e. an
# approximate collar location (never a coordinate, hole id or project). A
# client for whom that is confidential sets this EMPTY or mirrors the tiles.
# COLLAR_DEM_SOURCE is at most 32 characters (the column's width).
# COLLAR_DEM_URL_TEMPLATE=https://copernicus-dem-30m.s3.amazonaws.com/{tile}/{tile}.tif
# COLLAR_DEM_SOURCE=copernicus_glo30
# COLLAR_DEM_TIMEOUT_S=20

# blocks (default): typed text/table/image blocks — tables arrive as HTML
# with a bbox; the adapter renders each as markdown into the page text and
# returns the grid, and pdf_report indexes the grid as a "Table (OCR, page N,
# #k)" section while the narrative keeps only a "[Table k, page N]"
# placeholder (no double indexing). markdown: one string per page, tables
# inlined as HTML; supported as a fallback shape.
COHERE_PARSE_OUTPUT_FORMAT=blocks

# Parse describes every figure it sees. Those descriptions can contain
# transcribed numbers with no confidence behind them — exactly what the
# page-image verbalizer is forbidden from doing — so they stay OUT of the
# retrievable text unless you opt in.
COHERE_PARSE_INCLUDE_IMAGE_DESCRIPTIONS=0

# Pages rendered together and posted concurrently as one group on the
# OCR paths (was AZURE_DI_PAGES_PER_BATCH, pages per HTTP request). In-flight
# requests are additionally capped by PDF_OCR_PAGE_CONCURRENCY. Foundry TPM
# is shared with embed/rerank/LLM — this is the throttle if the answer path
# starts seeing 429s during a large scanned ingest. 1 disables grouping.
OCR_PAGES_PER_BATCH=8

# Per-document cap on pages sent to the remote engine (was
# AZURE_DI_MAX_PAGES_PER_DOC, whose fallback was removed 2026-09-16 with
# the rest of the Azure surface). Pages past
# the cap are read by tesseract, which extracts no table structure, and
# the parse result carries an `ocr_page_budget_exhausted` warning.
OCR_MAX_PAGES_PER_DOC=300

# Which pages of a text-layer PDF the remote engine reads (pdf_report.py
# module docstring; ocr_engine.selected_parse_mode). Only meaningful with
# OCR_ENGINE=cohere_parse and COHERE_API_KEY set — otherwise tables/all warn
# once and behave as ocr_only (tesseract on a born-digital page is strictly
# worse than its text layer). An unknown value logs CRITICAL once and behaves
# as ocr_only.
#   ocr_only  The engine reads only pages with no usable text layer. What a
#             worker degrades to without the engine or its key.
#   tables    prose stays native (exact citation text); text-layer pages with
#             a detected table or a resource/reserve/"Table N" hint are ALSO
#             read by the engine and its tables replace pdfplumber's for that
#             page. Pages the engine cannot answer for keep pdfplumber tables.
#   all       every page goes through the engine; native text is the fallback
#             only when the engine cannot answer (failed / over the
#             OCR_MAX_PAGES_PER_DOC budget / empty). Pages past the budget keep
#             their native text — they are not dropped and not sent to
#             tesseract. Bills every page: ~$1.50 per 1000 pages.
#             DEFAULT in code, compose and production (2026-10-04 / 2026-09-29).
# Measure before flipping: ops script src/fastapi/scripts/ops/parse_vs_native.py
# (workflow "Parse vs native comparison").
# This file keeps ocr_only on purpose: a dev .env usually has no COHERE_API_KEY
# or wants no per-page billing while iterating. Delete the line (or set `all`)
# to run the production path.
PDF_PARSE_MODE=ocr_only

# Which PDF pages are embedded as page IMAGES (page_image.py): all | figures |
# off. Code default is `all`; compose and Terraform set `figures`. With
# IMAGE_VERBALIZATION_ENABLED unset (it is, everywhere) every image passage is
# a "[Page N ... not yet described]" placeholder that takes top-k slots from
# real text, so only figure pages are staged. `all` stays selectable.
# IMAGE_EMBED_PAGE_SCOPE=figures

# Sliding-window chunk size for parsed documents (2026-08-20). Raised from
# 1500/200, which was sized for bge-small-en-v1.5's 512-token truncation
# limit — two embedding backends ago. The live embedder is Cohere Embed v4
# (128K-token context), so the old window was starving the model: 5 chunks
# x 1500 chars is ~1,900 tokens against a 100,000-token context budget.
#
# IMPORTANT: chunk boundaries are decided at PARSE time and stored in
# silver.document_passages. Changing these does nothing to already-ingested
# documents — they must be RE-INGESTED (re-parsed), not merely re-embedded.
# Set both back to 1500/200 to restore the old chunking without a redeploy.
PDF_CHUNK_WINDOW_CHARS=5000
PDF_CHUNK_OVERLAP_CHARS=500

# OCR review-routing thresholds (single line — must match the default baked
# into docker-compose.yml's hatchet-worker env; F19 mirrors it here so
# non-compose orchestrators get the same values).
#
# THESE NUMBERS ARE NOT CALIBRATED. They were round numbers chosen by hand,
# and the comment here used to call them "calibrated" — as did the
# assessment recorded against every page, because `thresholds_calibrated`
# was computed as "the env var parsed". Since 2026-08-21 that flag comes
# from an explicit `calibrated_from` key naming an artefact a reader can go
# and look at:
#
#   ..., "calibrated_from": "ops/baselines/ocr-calibration-2026-09-01.json"}
#
# Leaving it out changes no routing; it only stops the record claiming
# evidence that does not exist. That matters because the planned quality
# classifier is meant to train on these labels.
#
# SECOND KNOWN PROBLEM. Engines do not report confidence on the same scale
# — or at all. Tesseract reports 0.70-0.85 when it is doing fine; Cohere
# Parse (ADR-0019) reports NO per-word confidence, so its pages carry
# confidence_reported=false and the mean/median/low-ratio bands are
# skipped for them: only the content signals (coverage, gibberish,
# repeated characters, seams) route a Parse page. That means a clean Parse
# page would AUTO-ACCEPT under any threshold set. Until a Parse calibration
# artefact exists, keep every Parse page out of auto-accept with the
# per-engine floor (this is what docker-compose ships):
#
#   {..., "by_ocr_method": {
#       "tesseract":    {"spot_check_min_mean_confidence": 0.72},
#       "cohere_parse": {"floor_tier": "spot_check"}}}
#
# `floor_tier` is "spot_check" or "mandatory_review" — the worst tier a page
# may auto-route to under that block. An engine's block is merged over the
# shared set, so it states only what differs.
#
# The numbers above are ILLUSTRATIVE, not recommendations. Getting real ones
# means hand-labelling ~200 pages sampled across the live corpus's
# ocr_method values and fitting the bands to the observed distributions.
# Guessing per-engine numbers would repeat the mistake this comment exists
# to record.
OCR_ROUTING_THRESHOLDS_JSON={"catastrophic_max_mean_confidence":0.30,"catastrophic_max_coverage_ratio":0.20,"mandatory_min_mean_confidence":0.60,"mandatory_min_median_confidence":0.60,"mandatory_max_low_confidence_word_ratio":0.40,"mandatory_min_coverage_ratio":0.50,"mandatory_max_gibberish_word_ratio":0.30,"mandatory_max_repeated_character_ratio":0.20,"mandatory_max_seam_duplicate_ratio":0.20,"spot_check_min_mean_confidence":0.90,"spot_check_min_median_confidence":0.90,"spot_check_max_low_confidence_word_ratio":0.10,"spot_check_min_coverage_ratio":0.80,"spot_check_max_gibberish_word_ratio":0.10,"spot_check_max_repeated_character_ratio":0.05,"spot_check_max_seam_duplicate_ratio":0.05,"by_ocr_method":{"cohere_parse":{"floor_tier":"spot_check"}}}

# ── Anthropic backend ──────────────────────────────────────────────────
# Only used when LLM_BACKEND=anthropic. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Default model: claude-opus-4-8 (strongest agentic coding, 1M ctx, adaptive
# thinking). Alternatives: claude-sonnet-4-6 (cheaper/faster, 1M ctx) or
# claude-haiku-4-5 (fast path, 200k ctx) for the summary call.
ANTHROPIC_MODEL=claude-opus-4-8

# Max tokens the model may emit in a single response. Opus 4.8 supports up
# to 128k; 4096 is a sensible default for the GeoRAG summary task.
ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# Enable Anthropic prompt caching on the static system prompt. This cuts
# input cost ~90% and first-token latency ~60-80% on cache hits. Leave on.
ANTHROPIC_ENABLE_PROMPT_CACHING=true

# Priority tier buys guaranteed throughput at a cost premium. Leave off
# for development; enable in production if standard-tier 429s bite.
ANTHROPIC_USE_PRIORITY_TIER=false

# Model tier aliases — FastAPI orchestrator selects the right model per task
# complexity. Defaults below match claude.ai naming as of 2026-04.
# Fast  = lightweight tasks (routing, query rewrite, entity extraction)
# Standard = main RAG synthesis calls
# Deep = complex reasoning, long-context geological interpretation
#
# MODEL_TIER_FAST was removed 2026-09-07 with its only reader,
# app/agent/llm_classifier.py. Settings sets extra="forbid", so leaving the
# key here would turn every startup into a crash.

# ── Batch API (Dagster ingestion assets) ────────────────────────────────
# The same ANTHROPIC_API_KEY feeds both the synchronous path (FastAPI
# orchestrator) and the Batch API (Dagster bulk enrichment). The batch
# path is ~50% cheaper per token and is intended for non-interactive
# work: per-report entity extraction, chunk tagging, constraint auditing.
# Dagster assets that want extended output (300k tokens/response on Opus
# 4.7 / Sonnet 4.6) construct the client with extended_output=True —
# no env var needed for that flag today.
#
# Nothing else to configure here until an asset wires up an LLM step.

# ── Context budget (applies to all backends) ────────────────────────────
# The orchestrator caps retrieved data per category before prompting the LLM.
# Defaults fit qwen3-14b-awq (16K ctx — current primary). Raise when
# LLM_BACKEND=anthropic, or when rolling back to qwen2.5:14b (32K ctx).
#
# Suggested tunings:
#   vllm qwen3-14b-awq (A4500 20 GB):
#     MAX_CONTEXT_TOKENS=22000
#   vllm qwen3-14b-awq (16 GB GPU, prior era):
#     MAX_CONTEXT_TOKENS=15000
#   anthropic:
#     MAX_CONTEXT_TOKENS=200000
#
# Hardware-refresh (2026-05-08): bumped to A4500 20 GB profile. The +7000
# tokens of context budget (vs the 16 GB era) = ~3 extra document
# chunks or ~10 extra collar rows surface to grounded synthesis without
# truncation.
MAX_CONTEXT_TOKENS=22000

# Max self-correction retries after validator flags (Layer 3/4/6). Default
# is 2 — drop to 1 when LLM_BACKEND=anthropic since Opus 4.7's adaptive
# thinking self-corrects during the first call for most issues.

# Per-call cap on the visible answer tokens emitted by the OpenAI-compatible
# backend (vLLM). Mirrors ANTHROPIC_MAX_OUTPUT_TOKENS. Stops a small model
# stuck in a repetition loop from burning the FastAPI deadline.
LLM_MAX_OUTPUT_TOKENS=4096

# Extra num_predict budget added on free-text-with-thinking calls. Qwen3
# reasoning trace tokens go to the `reasoning` field but still draw from
# the response token budget, so without a bump the visible answer gets
# truncated when thinking is on. Set to 0 to disable. 2048 covers a
# typical 1-2K reasoning trace on grounded queries.
LLM_MAX_THINKING_TOKENS=2048

# Minimum retrieval quality score (0.0–1.0) below which the RAG pipeline
# rejects the result rather than prompting the LLM with low-quality context.
# Matches the hallucination prevention threshold in Section 04i.
RETRIEVAL_QUALITY_THRESHOLD=0.6


# =============================================================================
# vLLM — OpenAI-compatible GPU inference server (OPTIONAL, LLM_BACKEND=vllm only)
# Applies to: fastapi
#
# The local `vllm` compose service was removed 2026-07-30 (Cohere's own API
# is now the default backend — see the LLM CONFIGURATION section above).
# These settings only matter if you run your own external OpenAI-compatible
# endpoint and set LLM_BACKEND=vllm to point at it.
#
# Default model: Qwen3-14B-AWQ Instruct AWQ (W4A16, Marlin INT4 kernels).
# Sized for the dev workstation's RTX A4500 (20 GB VRAM, compute 8.6 —
# Ampere, no native FP8). AWQ INT4 weights are ~17 GB; KV cache budget
# at max-model-len=8192 is ~2 GB at gpu-memory-utilization=0.95.
#
# On larger GPUs (A6000, L40S, H100) raise VLLM_MAX_MODEL_LEN to 16384 or
# 32768 and consider switching to GPTQ-Int8 / BF16 for higher quality.
# On smaller GPUs (16 GB or less), switch to Qwen3-14B-AWQ.
# =============================================================================

# Internal URL that FastAPI uses to reach vLLM
# Required when LLM_BACKEND=vllm — FastAPI refuses to start without it.
VLLM_URL=

# Model ID sent to the external endpoint.
VLLM_MODEL=Qwen/Qwen3-14B-AWQ

# Quantization kernel selector passed to `--quantization`.
#   awq_marlin  — AWQ INT4 with Marlin kernels (Ampere+, near-FP16 throughput)
#   gptq_marlin — GPTQ INT4 equivalent
#   (empty)     — unquantized BF16 / FP16 (only viable on hardware with the
#                 VRAM to hold full-precision weights)
VLLM_QUANTIZATION=awq_marlin

# Maximum sequence length (prompt + completion, in tokens). Reduce if OOM
# during model load. On A4500 + AWQ 14B, 8192 is the safe ceiling.
VLLM_MAX_MODEL_LEN=8192

# HuggingFace access token — needed for gated repos (some Llama, Mistral
# tiers). The default Qwen3 AWQ repo is public, but set this anyway for
# forward-compat with model swaps.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=


# =============================================================================
# LARAVEL REVERB — WebSocket server
# Applies to: laravel-reverb, laravel-octane (broadcasting config)
#
# React clients connect to Reverb for real-time LLM token streaming.
# =============================================================================

# REQUIRED — generate with: openssl rand -base64 32
REVERB_APP_ID=georag-app
REVERB_APP_KEY=georag-reverb-key
REVERB_APP_SECRET=georag-reverb-secret

REVERB_HOST=0.0.0.0
# Host port for Reverb WebSocket. Default 8080 often conflicts — use 8085 if so.
REVERB_PORT=8085
# Internal container port Reverb listens on (mapped to REVERB_HOST_PORT on the host)
REVERB_HOST_PORT=8085
REVERB_SCHEME=http

# REQUIRED — both default to 10000 bytes in config/reverb.php, which is
# far too small for completed LLM answer frames: Reverb silently rejects
# any broadcast payload over the cap and the chat stream's final
# "completed" frame never reaches the browser. 1000000 matches the live
# stack. Raise BOTH together (server request cap + per-app message cap).
REVERB_MAX_REQUEST_SIZE=1000000
REVERB_APP_MAX_MESSAGE_SIZE=1000000


# =============================================================================
# FASTAPI — Python domain service
# Applies to: fastapi, laravel-octane, laravel-horizon
#
# Service-to-service auth: Laravel sends X-Service-Key header with every
# internal request to FastAPI. FastAPI rejects requests without a valid key.
# =============================================================================

# Host port compose publishes FastAPI on (docker-compose.yml `ports:`).
FASTAPI_PORT=8000

# Base URL Laravel uses for EVERY outbound call into FastAPI: the RAG stream,
# the Hatchet trigger endpoints, the MV-refresh run, the metric bridge and the
# export builders. `config/services.php` reads it into
# `services.fastapi.internal_url`; nothing in app/ should read the variable
# directly, because a cached config drops env() reads outside config files.
#
# The single most important cross-service setting. The default below is the
# compose service name and resolves to nothing outside compose; production
# sets it in deploy/aws/terraform/config.tf. This is the mirror image of
# LARAVEL_INTERNAL_URL, whose absence took the entire real-time layer down
# for weeks in the 2026-08-18 incident.
FASTAPI_INTERNAL_URL=http://fastapi:8000

# uvicorn worker count (hardware-refresh 2026-05-08).
# Threadripper Pro 5955WX (16 physical / 32 logical cores) on the
# dedicated dev workstation comfortably runs 6 workers without
# starving Postgres parallel workers (max_parallel_workers=12),
# vLLM offload threads (QWEN3_NUM_THREAD=12), or Dagster ingestion.
# Drop to 4 on smaller hardware (8-core / 16-thread); raise to 8 on
# >32-core servers. Each worker holds its own asyncpg pool + httpx
# pool, so don't over-provision.
UVICORN_WORKERS=6

# REQUIRED — shared secret for Laravel→FastAPI service auth.
# Also used as the HS256 signing secret for the short-TTL per-request JWTs
# that Laravel mints (see App\Services\FastApiJwtMinter, B7). FastAPI must
# hold the identical value under LARAVEL_SERVICE_KEY to verify signatures.
#
# MUST BE >= 32 bytes (256 bits). Both sides enforce this at boot (R13):
#   - FastAPI: Pydantic validator on Settings.FASTAPI_SERVICE_KEY
#   - Laravel: FastApiJwtMinter::mint() throws on a short secret
# The default placeholder below is intentionally a long string so new
# installs don't immediately fail validation — replace it for any
# non-local deployment.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
FASTAPI_SERVICE_KEY=REPLACE_ME_WITH_A_48_BYTE_TOKEN_URLSAFE_STRING_AT_LEAST_32_BYTES

# V1.5-03 — `kid` header on every minted JWT. Default `primary` matches the
# FastAPI `FASTAPI_SERVICE_KEY_KID` default. To rotate: stage the new key as
# FASTAPI_SERVICE_KEY_PREVIOUS on FastAPI side first, then bump this kid to
# something like `2026-q3`. See ops/runbooks/secret-rotation.md for steps.
FASTAPI_SERVICE_KEY_KID=primary

# V1.5-03 — optional rotation overlap. Set FASTAPI_SERVICE_KEY_PREVIOUS_KID +
# FASTAPI_SERVICE_KEY_PREVIOUS on the FastAPI side during a rotation window
# so both keys decode successfully. Since 2026-09-06 both sides also accept
# FASTAPI_SERVICE_KEY_PREVIOUS on the X-Service-Key header (FastAPI
# services/auth.py, Laravel VerifyServiceKey), so set it on the Laravel
# apps too while their callers roll. Leave empty in steady state.
# FASTAPI_SERVICE_KEY_PREVIOUS_KID=
# FASTAPI_SERVICE_KEY_PREVIOUS=

# Audit 2026-07-01 — the embedding/reranker/sparse sidecars (app/sidecar_auth.py)
# fail CLOSED (HTTP 503) if FASTAPI_SERVICE_KEY is unset on their process env,
# rather than silently running unauthenticated. docker-compose.yml already
# passes the key to every sidecar, so this should never trigger here — only
# set SIDECAR_AUTH_OPTIONAL=true if you're intentionally running a sidecar
# unauthenticated (e.g. an air-gapped single-host dev loop).
# SIDECAR_AUTH_OPTIONAL=true

# Security audit 2026-08-14 — two dormant FastAPI mitigations (both default
# OFF in app/config.py; see .env.production.example where both are ON).
# Wraps retrieved chunk text in delimiter tokens so the LLM can distinguish
# corpus content from instructions (prompt-injection hardening).
# PROMPT_INJECTION_DELIMITING_ENABLED=true
# Per-client API rate limiting (slowapi); RATE_LIMIT_DEFAULT /
# RATE_LIMIT_QUERIES tune the buckets. Keyed per (workspace, user) from the
# JWT. Counters are per-worker memory; leave RATE_LIMIT_STORAGE_URI unset. A
# redis:// URL is refused at startup (slowapi's storage is synchronous and
# would block the event loop on every request).
# RATE_LIMIT_ENABLED=true
# FastAPI /docs, /redoc and /openapi.json are OFF by default; enable locally.
# OPENAPI_DOCS_PUBLIC=true


# =============================================================================
# HATCHET / FLOWS / AUDIT — background workflow & notification secrets
# Applies to: fastapi, hatchet-worker
#
# All four vars below use docker-compose.yml's `${VAR:?msg}` syntax (no
# default) on at least one service, including fastapi — which this repo's
# CI workflows (ci.yml, eval-gate.yml, release-rehearsal.yml) bring up even
# when hatchet-worker itself is out of scope for that job. Note
# also that `docker compose up` interpolates every service's env block in
# the whole file up front, even services excluded by --profile or not
# passed on the command line — so a missing required var here breaks
# `docker compose up` even for jobs that never touch Hatchet.
# =============================================================================

# REQUIRED — Hatchet client auth token (a JWT minted by hatchet-lite for a
# registered tenant). Real bring-up: `docker exec georag-hatchet
# /hatchet-admin --config /config token create --name georag-worker
# --tenant-id <default-tenant-uuid>` — see the hatchet-worker service
# comment in docker-compose.yml. The placeholder below is enough to satisfy
# container startup and FastAPI's `/internal/v1/shadow/ingest_pdf/trigger`
# client construction; it will not authenticate against a real hatchet-lite.
HATCHET_CLIENT_TOKEN=CHANGE_ME_RUN_HATCHET_ADMIN_TOKEN_CREATE

# REQUIRED — shared fallback signing secret for the per-flow JWT bridge
# (Authorization: Bearer <jwt>, services/flow_jwt.py). Distinct from
# FASTAPI_SERVICE_KEY so rotating one doesn't disturb the other.
#
# Renamed from KESTRA_FLOW_JWT_SECRET 2026-09-14 (ADR-0022). Settings runs
# with extra="forbid", so the old key left in a .env is a startup crash
# naming this one — delete it rather than keeping both.
FLOW_JWT_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES

# REQUIRED — pgcrypto key used to decrypt per-flow JWT signing keys stored
# in workflow.flow_registry (app/services/flow_jwt.py) and the per-sender
# HMAC registry (usage.lookup_external_notification_sender_secrets()).
# 32-byte minimum per the hatchet-worker service comment in
# docker-compose.yml. Generate with: openssl rand -base64 32
AUDIT_ENCRYPTION_KEY=REPLACE_ME_WITH_A_RANDOM_KEY_AT_LEAST_32_BYTES

# Dormant, routed features — both 404 until turned on (2026-09-29, LAR-10/11).
# ADMIN_INTEGRATIONS_ENABLED gates /admin/integrations/* (sender + flow-JWT-key
# rotation; also needs AUDIT_ENCRYPTION_KEY above). CLOUD_INGEST_OAUTH_ENABLED
# gates /oauth/*; it also needs a migration for silver.cloud_ingest_connections
# (FORCE RLS + tenant_isolation) and OAUTH_{SHAREPOINT,ONEDRIVE,GOOGLEDRIVE}_
# CLIENT_ID / _CLIENT_SECRET — see OAuthIngestController's docblock.
# ADMIN_INTEGRATIONS_ENABLED=false
# CLOUD_INGEST_OAUTH_ENABLED=false

# REQUIRED — HMAC-SHA256 secret senders sign over canonical JSON payload
# fields for the external_notification Hatchet workflow. Must be the same
# value on the sender side. Generate with: openssl rand -base64 32
EXTERNAL_NOTIFICATION_HMAC_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES


# =============================================================================
# CROSS-DATABASE TIMEOUTS (Section 06e)
# Applies to: fastapi
#
# These cap individual database calls. asyncio.gather collects all results
# with an overall deadline of TIMEOUT_GATHER_S. Partial results are returned
# rather than failing the entire request on a single slow store.
# =============================================================================

# PostGIS/PostgreSQL query timeout (seconds)
TIMEOUT_POSTGIS_S=5

# Vestigial post-Neo4j-removal (Phase B1): AgentDeps.neo4j_driver is always
# None now, so every code path this timeout guards fails open immediately.
# Kept because app/config.py still declares the setting — harmless to
# leave, safe to delete once that dead code is cleaned up.
TIMEOUT_NEO4J_S=3

# Qdrant vector search timeout (seconds)
# Wraps the dense embed and the sparse encode as well as the Qdrant
# query itself -- on the hosted path those are 30s each, so a smaller
# number here means the outer budget always wins, and it wins by
# returning an EMPTY result rather than raising.
TIMEOUT_QDRANT_S=45

# Overall asyncio.gather deadline (seconds) — covers parallel fan-out across all stores
# Module 6 Chunk 3.5 2026-04-22: raised to 180 to accommodate four §04i guards
# (numeric + entity + completeness + refusal) running synchronously after LLM synthesis.
# On the dev GPU (RTX 4080, qwen3-14b-awq, ~14.6 tok/s), the full pipeline fits in 180s.
# Prod GPU with higher TPS can use a lower value (e.g., 120 or 90).
TIMEOUT_GATHER_S=180


# =============================================================================
# LARAVEL FRAMEWORK — DB / CACHE / SESSION / QUEUE
# These map GeoRAG infrastructure vars to the names Laravel config files expect.
# DB connects through PgBouncer (port 6432), never PostgreSQL directly (5432).
# =============================================================================

DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=6432
DB_DATABASE="${POSTGRES_DB}"
DB_USERNAME="${POSTGRES_USER}"
DB_PASSWORD="${POSTGRES_PASSWORD}"

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Max concurrent LLM streaming workers (supervisor-llm in config/horizon.php).
# Must be <= FastAPI /internal/queries concurrency and the vLLM slot count.
# Each worker holds one open SSE connection for the full query duration.
HORIZON_LLM_MAX_PROCESSES=2
# supervisor-llm reserves jobs through the `redis-llm` queue connection
# (config/queue.php), whose retry_after MUST exceed the supervisor timeout
# (360 s), which must exceed the streaming job's timeout (300 s). Leave
# unset unless you raise FASTAPI_STREAM_TIMEOUT; the contract test in
# tests/Unit/Config/ServiceConfigContractTest.php enforces the ordering.
# REDIS_LLM_QUEUE_RETRY_AFTER=420

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
MAIL_MAILER=log

OCTANE_SERVER=swoole

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# V1.5-12 — Map base layers (DEM + satellite). Default empty here so the
# SPA falls back to the public CDNs (Mapterhorn DEM + EOX Sentinel-2). On-prem
# deployments override these with self-hosted Martin or nginx URLs. See
# ops/runbooks/dem-self-host.md for the self-hosting procedure.
# VITE_DEM_TILES_URL=https://tiles.mapterhorn.com/tilejson.json
# VITE_SATELLITE_TILES_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg


# =============================================================================
# BACKUP CONFIGURATION (BK-01/BK-02/BK-05/BK-06 fix — 2026-04-19 infra audit)
# Applies to: postgresql, qdrant, redis (backup scripts run as Hatchet
# workflows — app/hatchet_workflows/backup_*.py — since Ofelia was dropped)
#
# Backups are staged locally then uploaded to SeaweedFS via AWS CLI S3 API.
# The backup destination uses the same MINIO_* credentials as the object store
# (SeaweedFS keeps the MINIO_* naming convention per ADR-0001 compatibility).
#
# Primary destination: s3://georag-backups/ on SeaweedFS
# Staging volume: backup_staging (named Docker volume, ephemeral — cleared after upload)
# =============================================================================

# S3-compatible endpoint for backup uploads. Points at SeaweedFS S3 API.
# Uses the same endpoint as MINIO_ENDPOINT — defined here separately for
# scripts that run in containers that may not have MINIO_ENDPOINT set.
# Format: http://<host>:<port>  (no trailing slash)
S3_ENDPOINT_URL=http://minio:8333

# AWS CLI credentials for backup uploads to SeaweedFS.
# These match the SeaweedFS root credentials (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
# Scripts read these directly — do not share with untrusted services.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Retention in days — backups older than this are deleted from S3 automatically
# by the retention sweep at the end of each backup script.
BACKUP_RETENTION_DAYS=7

QDRANT_URL=http://qdrant:6333

# ---------------------------------------------------------------------------
# Module 6 Phase B Chunk 2+3 — Citation span resolver
# ---------------------------------------------------------------------------
# When true, the post-gen span resolver parses answer text for citation
# markers in colon form ([DATA:N], [NI43:N], [PUB:N], [PGEO:N], [ev:<id>]),
# computes character offsets, and writes rows to silver.answer_citation_items
# + silver.answer_citation_spans.  Also enables four §04i guards (numeric,
# entity, completeness, refusal meta-guard).
#
# LIVE state: Chunk 3.6 (2026-04-22) — flag confirmed live after prompt trim.
# v9 preamble trimmed to byte-parity with v8 (3298 chars each). S1 smoke
# passed at 87.3s warm wall time on RTX 4080 / qwen3-14b-awq. Colon-form
# markers [DATA:N] confirmed in model output. Lifecycle draft->committed live.
# See ops/audit/2026-04-21-citation-guards-audit.md Chunk 3.6 section.
#
# Set to false in new installs until the citation pipeline review is
# completed for that deployment context. FastAPI restart required on flip.
# (Was shipped as `true` here, self-contradicting this same comment — the
# live Azure deployment doesn't override this var at all and actually runs
# on config.py's own default (false); caught in a full-app review,
# 2026-08-05.)
CITATION_SPAN_RESOLVER_ENABLED=false

# ---------------------------------------------------------------------------
# RETIRED 2026-07-29 — docling is no longer in the image
# ---------------------------------------------------------------------------
# These four knobs are kept commented, not deleted, because .env.example is
# what people diff their own .env against and a vanished key reads as "I
# must have imagined this". Setting any of them has no effect: docling was
# removed from docker/fastapi.Dockerfile on 2026-07-29 and
# PDF_PARSER_DOCLING_ENABLED was false in every live deployment before that
# (see the notes in app/models/pdf.py, app/agent/figure_extractor.py and
# ingest_pdf.py, all of which say it never ran in production).
#
# The OCR path today is: pypdfium2 native text -> pdfplumber -> Cohere
# Parse (Foundry, ADR-0019) -> tesseract. See §04p in georag-architecture.html.
#
# PDF_PARSER_DOCLING_ENABLED=true
# DOCLING_OCR_ENABLED=true

# Phase 2.1 kickoff requirement — tesseract is the fallback-of-last-
# resort for image pages when docling is unavailable or fails. Required
# for no-data-loss on hosts without GPU / when docling import breaks.
PDF_PARSER_TESSERACT_FALLBACK_ENABLED=true

# RETIRED 2026-07-29 with the docling knobs above. Commented rather than
# deleted for the same reason: .env.example is what people diff against.
#
# DOCLING_GPU_ENABLED's comment was a careful VRAM trade-off between
# docling's layout model and vLLM on the A4500. BOTH sides of it are gone:
# docling left the image on 2026-07-29 and vLLM was cut over to Azure AI
# Foundry on 2026-07-30. Following it would mean reasoning about two
# services that no longer run.
#
# DOCLING_GPU_ENABLED=false
# RAPIDOCR_MODEL_DIR=/tmp/rapidocr_models
# DOCLING_OCR_LANGS=english

# Page-level parallelism inside a single pdfplumber parse. Default 4
# so two parses can run on 8 cores without fighting; bump up on
# headless boxes with more cores. Set to 1 for sequential debugging.
PDF_PARSE_PAGE_WORKERS=4

# ---------------------------------------------------------------------------
# Phase 4 (2026-05-22) — table extraction overhaul
# ---------------------------------------------------------------------------
# Per-page classification thresholds for the bordered-vs-borderless
# router. Bordered pages (≥ either threshold) prefer docling TableFormer;
# borderless pages get the pdfplumber text strategy only. Tune up if
# your corpus has lots of decorative rectangles unrelated to tables.
TABLE_BORDER_LINE_THRESHOLD=3
TABLE_BORDER_RECT_THRESHOLD=20

# RETIRED 2026-07-29 with the rest of the docling knobs above. Bordered
# pages are handled by pdfplumber-lines at every page count now.
# PDF_PARSER_DOCLING_TABLES_MIN_BORDERED_PAGES=30

# ---------------------------------------------------------------------------
# Phase 5 (2026-05-22) — subprocess pool sizing + memory guard
# ---------------------------------------------------------------------------
# Number of PDFs the parse task can process in parallel per worker.
# Previously hardcoded to 1, which meant Hatchet's 20-slot ingestion
# pool serialized parses through one subprocess. Leaving this empty
# defers to min(os.cpu_count(), 4) — safe default for an 8-core
# workstation. Override to 1 to revert to legacy single-parse.
PARSE_SUBPROCESS_MAX_WORKERS=

# Minimum available RAM (MB) before submitting a parse to the pool.
#
# Raised 2026-05-23 from 1500 to 4500 after the TIFF smoke proved a single
# docling parse needed ~3-4 GB resident (PaddleOCR + RapidOCR +
# transformers + layout model); the old 1500 MB threshold passed even when
# the parse would then OOM-kill the subprocess. See
# [[tiff-smoke-2026-05-23]] for that root-cause analysis.
#
# Docling was retired on 2026-07-29, so the measurement that set this
# number no longer describes the workload. The value is kept because
# nobody has re-measured the pypdfium2 + pdfplumber + tesseract path, NOT
# because 4500 is still known to be right — it is now a ceiling with no
# evidence under it. Re-measure before lowering it; the failure mode it
# guards against (an OOM-killed parse subprocess) is silent from the
# outside.
PARSE_MIN_FREE_RAM_MB=4500

# Max seconds the parse task waits for memory headroom before raising
# MemoryError. Hatchet's parse.retries=1 catches it and tries on a
# freer worker. Default raised 2026-05-23 from 30 → 120 because the
# per-workspace concurrency cap (Q) means parses now QUEUE — a 30 s
# wait was a hangover from the unbounded-concurrency era. 120 s gives
# transient pressure (e.g. a competing workspace's parse) room to
# clear instead of giving up immediately.
PARSE_MEMORY_WAIT_MAX_S=120

# =============================================================================
# §04p Stage-6 VL model (ADR-0015 — Qwen3-VL migration)
# =============================================================================
# Two-version model registry for the figure/caption VL reasoning model.
# Default stays at v2 (Qwen2.5-VL-7B-Instruct) until the shadow-eval gate
# in ADR-0015 step 3 passes. Flip to v3 with:
#
#     docker exec georag-fastapi sh -c "echo 'PDF_VL_MODEL_VERSION=3' >> /app/.env"
#     docker compose restart fastapi
#
# No image rebuild required. To roll back, set =2 and restart.
#
# NOTE (2026-06-28): there is NO official Qwen3-VL-8B AWQ, and the community
# 8B quants (~6-7 GB) do NOT fit on the dev A4500 alongside the main 14B vLLM.
# v3 therefore uses the community Qwen3-VL-*4B* 8-bit quant that DOES fit (see
# the vllm-vl sidecar in docker-compose.yml). The earlier "Qwen3-VL-8B-AWQ"
# default here was aspirational and never existed.

PDF_VL_MODEL_VERSION=2
# PDF_VL_MODEL_ID            # explicit override; wins over MODEL_VERSION
# PDF_VL_MODEL_ID_V2=Qwen/Qwen2.5-VL-7B-Instruct                 # baked default
# PDF_VL_MODEL_ID_V3=cyankiwi/Qwen3-VL-4B-Instruct-AWQ-8bit      # baked default (real)

# =============================================================================
# §04p full-page parser backend (ADR-0016 Phase 2 — PaddleOCR-VL)
# =============================================================================
# docling (default) — current Stage-1.C-i layout + per-region OCR via PP-OCRv5
# paddleocr-vl      — end-to-end VLM-style parser (PaddleOCR-VL-1.6, 1.0B BF16)
#
# Phase 2 will install the [doc-parser] extra at image build time and
# enable runtime selection via this flag. Until the per-document-class
# routing in ADR-0016 step 5 is decided, leave this at docling.


# =============================================================================
# OPERATOR SETTINGS -- read by code, previously undocumented
# =============================================================================
# Each of these is read by application code and had no entry in this file, so
# the only way to discover it was to grep the source. Values shown are the
# in-code defaults; uncomment to override.

# Comma-separated allowlist of emails permitted to open /horizon outside the
# local environment. Empty means NO ACCESS -- fail closed is deliberate, a
# deploy that forgets this must not expose the queue dashboard. Normalised
# (lowercased, trimmed) in config/services.php.
# HORIZON_ADMIN_EMAILS=ops@example.com,kyle@example.com

# Absolute ceiling for a single uploaded file, in bytes. Flows to the Swoole
# packet cap AND to every `max:` validation rule from one place, so the
# transport and the validator cannot disagree. The default is sized against
# laravel-octane-cc's 2 GiB allocation -- see App\Support\Uploads for the
# arithmetic before raising it.
# GEORAG_MAX_UPLOAD_BYTES=536870912

# Largest CSV / Excel / dBASE / Access file ingest_tabular will read, in bytes.
# Refused before the download, with the reason on the run. Lower than the upload
# ceiling above because a delimited file is held in memory several times over on
# the 8 GiB ingest worker (rasters and Geosoft grids do not come through here).
# Raise it only together with the worker's memory.
# INGEST_TABULAR_MAX_BYTES=157286400

# Whether $request->ip() may trust a client-supplied X-Forwarded-For in
# production. OFF by default since the 2026-08-20 finding that the Container
# Apps ingress passes the header through rather than appending to it, which
# made the client IP whatever the caller typed -- and the IP is what the
# login rate limiter keys on. See App\Support\ProxyTrust.
# TRUST_FORWARDED_FOR=false

# Whether POST /api/v1/auth/register creates accounts. Closed by default:
# there is no registration UI, and a stranger with an account lands inside a
# tenant. Ask an administrator for an account instead.
# REGISTRATION_OPEN=false

# Route `ai:reingest-project` at silver.document_passages rather than the
# legacy chunk table. See App\Console\Commands\Ingestion\ReingestProject.
# RETRIEVAL_USE_DOCUMENT_PASSAGES=true

# =============================================================================
# BASEMAPS -- MapLibre network dependencies (CLAUDE.md hard rule #8)
# =============================================================================
# The style URL is the one thing maplibre-gl fetches over the network, so an
# air-gapped deployment repoints these at a local tile server and reaches
# nothing public. Shared to the SPA as Inertia props by
# HandleInertiaRequests and read through resources/js/lib/basemap.ts.
#
# Defaults below are public CDNs, which is correct for cloud deployments and
# wrong for on-prem. Until 2026-08-22 the config block these feed did not
# exist, so the defaults were the ONLY behaviour and no variable could
# change them.
# BASEMAP_STYLE_POSITRON=https://tiles.openfreemap.org/styles/positron
# BASEMAP_STYLE_BRIGHT=https://tiles.openfreemap.org/styles/bright
# BASEMAP_STYLE_DARK_MATTER=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Font PBFs for styles built inline (the satellite basemap's).
# BASEMAP_GLYPHS_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/glyphs/{fontstack}/{range}.pbf
# Raster tile template for the satellite basemap -- a tile source, not a style.
# BASEMAP_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# BASEMAP_SATELLITE_ATTRIBUTION=Tiles (c) Esri
# MapView (Foundry/PublicGeoscience + the inline maps in chat) uses a
# terrain-RGB DEM and Sentinel-2 cloudless imagery -- different providers
# from the Esri satellite above, which is a Workspace-map thing. Both were
# hard-coded until 2026-08-22, preconnected in app.blade.php, and MISSING
# from the CSP's connect-src, so terrain and satellite mode were blocked in
# production. Configuring them here is what puts them in the allowlist.
# BASEMAP_DEM_TILES=https://tiles.mapterhorn.com/tilejson.json
# BASEMAP_IMAGERY_TILES=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2020_3857/default/g/{z}/{y}/{x}.jpg
#
# VITE_DEM_TILES_URL / VITE_SATELLITE_TILES_URL still win when a build baked
# them in, so an existing deployment is unaffected. Prefer the two above for
# anything new: `import.meta.env` substitutes at BUILD time, so the Vite
# pair cannot be changed without rebuilding the SPA -- which is the opposite
# of what their comment in MapView claimed.
