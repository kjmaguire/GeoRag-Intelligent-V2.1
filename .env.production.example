# =============================================================================
# GeoRAG Intelligence V1.0 — Production Environment Variables
# =============================================================================
#
# This is the PRODUCTION template. All keys the stack reads are listed here
# with safe defaults or CHANGE_ME_VAULT_REFERENCE placeholders for secrets.
#
# Workflow:
#   1. Copy to .env.production (never commit the filled file)
#   2. Fill every CHANGE_ME_* placeholder using your secrets manager
#      (see ops/runbooks/secret-management.md for SOPS + age procedure)
#   3. Reference from docker-compose.yml via --env-file .env.production
#
# Secret format convention:
#   CHANGE_ME_VAULT_REFERENCE  — must be replaced; never leave as-is
#   CHANGE_ME_GENERATE_*       — generate with the command shown in the comment
#
# Differences from .env.example (dev defaults → production values):
#   APP_ENV=production
#   APP_DEBUG=false
#   LOG_LEVEL=info
#   SESSION_SECURE_COOKIE=true
#   TRUSTED_PROXIES=<real CIDR — not wildcard>
#   MULTI_TENANT_ENFORCEMENT_ENABLED=true
#   SINGLE_TENANT_MODE=false
#   All *_PASSWORD keys = CHANGE_ME_VAULT_REFERENCE
#
# 2026-07-30 rewrite — this file had drifted badly from the live stack. It
# still documented LLM_BACKEND=vllm as primary and had full sections for
# Neo4j, Dagster, RAGFlow, Prometheus/Grafana/Alertmanager/Loki — none of
# which have a service block left in docker-compose.yml. Those sections
# were removed rather than commented out, because keeping dead blocks
# around is exactly what let this file drift the first time.
#
# 2026-09-08 (ADR-0022) — Azure AI Foundry and STORAGE_BACKEND=azure_blob
# are gone with the cloud; Amazon Bedrock and real S3 replace them.
#
# ⚠️ READ THIS BEFORE USING THE FILE FOR PRODUCTION.
#
# On AWS this template is NOT how production is configured, and that is the
# point. Every non-secret value below is set by
# `deploy/aws/terraform/config.tf`, and every secret is a Secrets Manager
# reference injected by the ECS execution role. This file remains useful as
# (a) documentation of what the stack reads, and (b) the template for an
# on-premise or docker-compose production deployment.
#
# The reason for the split is recorded in `deploy/azure/README.md` under
# "What is NOT here": there was no infrastructure-as-code for the Azure
# container apps, so ~55 environment variables per app were set by hand and
# drifted freely from THIS FILE, with nothing running that could be diffed
# against anything in the repository. A template that production does not
# read cannot drift from it.
# =============================================================================


# =============================================================================
# APPLICATION — laravel-octane, laravel-horizon, laravel-reverb
# =============================================================================

APP_NAME="GeoRAG Intelligence"

# Must be "production". Changing this disables debug mode, sets cookie flags,
# and enables production-safe error handling throughout Laravel.
APP_ENV=production

# Generate: php artisan key:generate --show (run inside the container)
# Must be exactly 32 bytes, base64-encoded: base64:<value>
APP_KEY=CHANGE_ME_VAULT_REFERENCE

# Must be false in production. Exposing stack traces leaks internal paths.
APP_DEBUG=false

# Public HTTPS URL of the application. Used for redirects, asset URLs, email links.
APP_URL=https://your-georag-domain.example.com

# Host port for Laravel Octane. Default 80 (behind nginx/Traefik reverse proxy).
APP_PORT=80

# info is appropriate for production. Use warning to reduce I/O on busy hosts.
# Options: debug | info | warning | error | critical
LOG_LEVEL=info

# Octane worker settings. 8-core Ryzen workstation: 6 workers leaves 2 cores
# for the OS and other services. Tune to (cpu_cores - 2) for production hosts.
OCTANE_WORKERS=6
OCTANE_TASK_WORKERS=8
OCTANE_MAX_REQUESTS=500

# Swoole is the production server. RoadRunner is the alternative.
OCTANE_SERVER=swoole

# Reverse-proxy IP allowlist for X-Forwarded-* trust.
# Production: set to the explicit CIDR of your nginx/Traefik front-end.
# Do NOT use '*' in production — it allows clients to spoof X-Forwarded-For.
# Example: TRUSTED_PROXIES=10.0.0.0/8
TRUSTED_PROXIES=CHANGE_ME_YOUR_PROXY_CIDR

# Session cookie must be sent over HTTPS only.
SESSION_SECURE_COOKIE=true

# Comma-separated list of domains Laravel Sanctum allows stateful requests from.
# Must match the exact production domain (no wildcard).
SANCTUM_STATEFUL_DOMAINS=your-georag-domain.example.com

# CORS: which origins may call the API. Set to your exact frontend origin.
CORS_ALLOWED_ORIGINS=https://your-georag-domain.example.com

# Enforce multi-tenant workspace isolation (Module 9). Must be true in prod.
MULTI_TENANT_ENFORCEMENT_ENABLED=true
SINGLE_TENANT_MODE=false


# =============================================================================
# POSTGRESQL / POSTGIS — postgresql, pgbouncer, laravel-*, fastapi, hatchet-worker
#
# Applications connect via PgBouncer (port 6432), NOT PostgreSQL directly (5432).
# PostgreSQL port 5432 is NOT exposed to the host in production.
# =============================================================================

POSTGRES_DB=georag
POSTGRES_USER=georag
POSTGRES_PASSWORD=CHANGE_ME_VAULT_REFERENCE

# Laravel connects to Postgres as its own `georag_app` role, not the
# `georag` owner role above — separate credential so the runtime app is
# never granted schema-owner privileges (see docker-compose.yml laravel-*
# DB_PASSWORD wiring).
GEORAG_APP_USER=georag_app
GEORAG_APP_PASSWORD=CHANGE_ME_VAULT_REFERENCE

# PgBouncer port exposed to host for direct psql inspection.
PGBOUNCER_PORT=6432

# PostgreSQL performance tuning (Section 06a) — NVMe workstation 64 GB RAM:
# shared_buffers: ~25% of system RAM
POSTGRES_SHARED_BUFFERS=16GB

# effective_cache_size: ~75% of system RAM
POSTGRES_EFFECTIVE_CACHE_SIZE=48GB

# work_mem: 256MB for production (128MB for dev). High values risk OOM if many
# simultaneous complex queries run. Monitor with pg_stat_statements.
POSTGRES_WORK_MEM=256MB

# CRITICAL: 1.1 for NVMe. Default 4.0 assumes spinning disks and will cause
# the planner to choose sequential scans over index scans. Never use 4.0 on NVMe.
POSTGRES_RANDOM_PAGE_COST=1.1

# Maximum direct connections to PostgreSQL (PgBouncer multiplexes these).
POSTGRES_MAX_CONNECTIONS=200

# Laravel framework wiring — connects through PgBouncer
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=6432
DB_DATABASE=georag
DB_USERNAME=georag
DB_PASSWORD=CHANGE_ME_VAULT_REFERENCE


# =============================================================================
# REDIS 8 — laravel-*, fastapi
#
# Used for: application cache, session storage, Horizon job queues.
#
# THE FOUR REDIS_ SERVER SETTINGS BELOW ARE READ BY docker-compose ONLY.
# In production the redis service runs the command line in
# deploy/aws/terraform/services.tf, which does not read this file. Changing
# REDIS_MAXMEMORY here has no effect on production and never has. They are
# kept because compose-based deployments (on-prem, air-gapped) do read
# them, and annotated because their values disagreed with the live Azure
# server for months without anyone having a reason to notice.
#
# One thing DID change in production on 2026-09-08 (ADR-0022): AOF is on
# and there is a volume. On Azure `redis-cc` ran with AOF off and no
# volume at all, so every restart — and every nightly scale-to-zero —
# dropped all sessions and any queued Horizon job. That was the one store
# in this platform with no persistence whatsoever.
#
# `volatile-lru` remains non-negotiable and is enforced by
# scripts/check_redis_manifests.py: one instance holds queue jobs with no
# TTL beside TTL'd cache and sessions, so `allkeys-lru` would evict a
# queued job.
# =============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_VAULT_REFERENCE

# Compose only. Keep maxmemory at or under 80% of the container's memory
# limit: Redis's cap covers its own dataset, while client buffers,
# fragmentation and fork copy-on-write sit on top of it.
REDIS_MAXMEMORY=2gb
# volatile-lru evicts only keys carrying a TTL — cache entries and
# sessions — and never a queued job, which has none. allkeys-lru (the
# previous value here) would evict queue jobs silently; noeviction would
# refuse every write once full, including queue pushes.
REDIS_MAXMEMORY_POLICY=volatile-lru

# Compose only, and only meaningful because docker-compose.yml mounts
# redis_data:/data. AOF without a volume is not durability — it is fsyncs
# and rewrite forks writing to a disk that is discarded on restart.
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# Laravel framework wiring
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# Max concurrent LLM streaming Horizon workers. Each holds one SSE connection
# for the full query duration. Tune to FastAPI concurrency slots.
HORIZON_LLM_MAX_PROCESSES=4


# =============================================================================
# QDRANT v1.17 — qdrant, fastapi
#
# HNSW m=16, ef_construct=200 are set at service level.
# Per-collection indices and scalar quantization are applied by FastAPI on
# collection creation.
# =============================================================================

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333

# Production: set a strong API key. Dev can leave empty (network isolation only).
# QDRANT__SERVICE__API_KEY must also be set in the qdrant service environment.
QDRANT_API_KEY=CHANGE_ME_VAULT_REFERENCE

# HNSW index parameters — do not reduce below these values in production.
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=200
QDRANT_HNSW_EF=128


# =============================================================================
# OBJECT STORAGE — laravel-*, fastapi, hatchet-worker (and minio in compose)
#
# STORAGE_BACKEND picks the object-storage implementation on BOTH layers —
# georag_object_storage (Python) and every s3* disk in
# config/filesystems.php. It had two values until 2026-09-08; `azure_blob`
# went with the cloud (ADR-0022) and `s3_compatible` is all that remains,
# covering SeaweedFS or MinIO in dev and on-prem, and real AWS S3 in
# production.
#
# The variable is kept rather than deleted so a deployment that was never
# repointed fails loudly: georag_object_storage's factory raises
# NotImplementedError naming the retired value, instead of silently
# selecting something.
#
# Bronze layer: immutable raw file archive. Keys are backend-agnostic
# (reports/{project_id}/…, figures/{report_id}/…).
# =============================================================================

STORAGE_BACKEND=s3_compatible

# ── Real AWS S3 (production) ───────────────────────────────────────────────
# LEAVE THE CREDENTIALS AND THE ENDPOINT UNSET. Both matter:
#
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — unset means "use the
#   credential chain", which on ECS is the task role. Since 2026-09-08 the
#   Python layer omits the keys rather than passing None, because explicit
#   None credentials can short-circuit boto3's own resolution and leave a
#   perfectly good role unused. Setting them together is fine; setting one
#   without the other is a hard error.
#
#   AWS_ENDPOINT_URL — unset means "resolve the regional S3 endpoint". A
#   value pins EVERY call to that host, which is right for SeaweedFS and
#   wrong for S3. It used to default to http://minio:8333, so an unset
#   variable on an AWS task pointed every S3 call at a service name that
#   does not resolve there.
#
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET_BRONZE=georag-bronze-<account-id>
# AWS_BUCKET_BRONZE_RASTER=georag-bronze-raster-<account-id>
# AWS_BUCKET_EXPORTS=georag-exports-<account-id>
# AWS_BUCKET_BACKUPS=georag-backups-<account-id>
#
# Unlike Azure Blob, presigned URLs are native to the role: Laravel's
# temporaryUrl() signs with the task role's credentials and needs no
# account key. That is why Azure's `allowSharedKeyAccess` — enabled ONLY
# because temporaryUrl() had no alternative — has no successor here.

# ── SeaweedFS / MinIO (compose and on-premise) ─────────────────────────────
# Variable names keep the MINIO_ prefix for backward compat (ADR-0001:
# SeaweedFS replaces MinIO). API port: 8333 | Filer/admin: 8888.
MINIO_ROOT_USER=georag-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_VAULT_REFERENCE

MINIO_API_PORT=8333
MINIO_CONSOLE_PORT=8888
MINIO_ENDPOINT=http://minio:8333

MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_BRONZE_RASTER=bronze-raster

# S3-compatible endpoint for the compose-only backup scripts
# (docker/postgresql/backup.sh, docker/qdrant/backup.sh); same as
# MINIO_ENDPOINT.
#
# On AWS, durability is RDS automated backups with 35-day PITR for Postgres,
# and S3 bucket VERSIONING with 90-day non-current retention for object
# storage. That second half is new: on Azure, blob was the one irreplaceable
# copy — no backup workflow (the backup_* workflows were deleted 2026-08-23)
# and no restore procedure, with PITR covering Postgres only.
S3_ENDPOINT_URL=http://minio:8333

# Backup retention: days before old backups are purged from S3
# (compose-only backup scripts).
BACKUP_RETENTION_DAYS=30


# =============================================================================
# FASTAPI — fastapi, laravel-octane, laravel-horizon
#
# Service-to-service auth: Laravel sends JWT signed with FASTAPI_SERVICE_KEY.
# FastAPI verifies with the identical secret. Must be >= 32 bytes.
# =============================================================================

FASTAPI_HOST=fastapi
FASTAPI_PORT=8000

# REQUIRED in production. Base URL for every Laravel -> FastAPI call. The
# default baked into config/services.php is the docker-compose service name
# and resolves to nothing on Container Apps, where this must be the internal
# Internal address of the FastAPI service. On ECS this is Cloud Map service
# discovery (http://fastapi.georag.internal:8000) and is set by
# deploy/aws/terraform/config.tf. The mirror of
# LARAVEL_INTERNAL_URL, whose absence silently killed the entire real-time
# layer for weeks in the 2026-08-18 incident.
FASTAPI_INTERNAL_URL=http://fastapi.georag.internal:8000

# Comma-separated allowlist for the /horizon dashboard. EMPTY MEANS NOBODY
# CAN OPEN IT -- fail closed by design. Nothing read this variable until
# 2026-08-22, so setting it previously had no effect.
HORIZON_ADMIN_EMAILS=CHANGE_ME_OPS_EMAILS

# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# BOTH Laravel and FastAPI must hold the identical value.
FASTAPI_SERVICE_KEY=CHANGE_ME_VAULT_REFERENCE

# V1.5-03 — `kid` (key id) header on every minted JWT. The kid identifies
# which signing key minted the token; FastAPI maps kid → secret to support
# zero-downtime rotation. Standard initial value:
FASTAPI_SERVICE_KEY_KID=primary

# V1.5-03 — rotation overlap window. During key rotation, set both keys
# (PREVIOUS = outgoing kid+secret pair) so FastAPI accepts BOTH for ~1h
# while Laravel cuts over to the new mint kid. Since 2026-09-06 the
# X-Service-Key header path honours PREVIOUS on both sides, so set
# FASTAPI_SERVICE_KEY_PREVIOUS on the Laravel services as well as fastapi
# during the window. Empty in steady state.
# Documented in ops/runbooks/secret-rotation.md § 3.
# FASTAPI_SERVICE_KEY_PREVIOUS_KID=
# FASTAPI_SERVICE_KEY_PREVIOUS=

# Audit 2026-07-01 — the embedding/reranker/sparse sidecars fail CLOSED
# (HTTP 503) if FASTAPI_SERVICE_KEY is unset on their process env, rather
# than silently running unauthenticated. Only set this if you're
# intentionally running a sidecar unauthenticated — should stay unset in
# production.
# SIDECAR_AUTH_OPTIONAL=true

# Security audit 2026-08-14 — prompt-injection hardening: wrap retrieved
# chunk text in delimiter tokens so corpus content can't masquerade as
# instructions. Must be ON in production.
PROMPT_INJECTION_DELIMITING_ENABLED=true

# Security audit 2026-08-14 — per-client API rate limiting (slowapi).
# Must be ON in production; RATE_LIMIT_DEFAULT / RATE_LIMIT_QUERIES tune it.
RATE_LIMIT_ENABLED=true


# =============================================================================
# CROSS-DATABASE TIMEOUTS (Section 06e) — fastapi
#
# These cap individual database calls. asyncio.gather collects all with an
# overall deadline of TIMEOUT_GATHER_S. Partial results are returned rather
# than failing the entire request on a single slow store.
# =============================================================================

TIMEOUT_POSTGIS_S=5

# Vestigial post-B1 (2026-07-28 Neo4j removal): AgentDeps.neo4j_driver is
# always None now, so every code path this timeout guards fails open
# immediately. Kept because app/config.py still declares the setting —
# harmless to leave, safe to delete once that dead code is cleaned up.
TIMEOUT_NEO4J_S=3

TIMEOUT_QDRANT_S=2
TIMEOUT_REDIS_MS=500

# Overall asyncio.gather deadline (seconds). Left at the pre-migration value
# rather than guessed down — Cohere Command A+ likely has higher raw
# throughput than the retired local vLLM path, but every call now also
# crosses the network to Bedrock, and no real latency numbers exist
# yet (C8's golden-path smoke test hasn't run). Cutting this before that
# data exists risks truncating an answer that already cost the tokens to
# generate — pure waste, not a saving. Retune only after measuring.
TIMEOUT_GATHER_S=180


# =============================================================================
# LLM CONFIGURATION — fastapi
#
# Backends — select via LLM_BACKEND:
#   bedrock    (default, production primary) → Amazon Bedrock, Cohere
#                Command A+ through the Converse API. Requires BEDROCK_*
#                below. Cutover 2026-09-08 (ADR-0022).
#   vllm       (legacy/optional) → An OpenAI-compatible endpoint (vLLM or
#                equivalent) you run and operate yourself. The local `vllm`
#                compose service was removed on 2026-07-30 — point VLLM_URL
#                at an external instance if you use this backend.
#   anthropic  (optional fallback) → Claude API, an independent failure
#                domain from Bedrock.
#
#   azure      RETIRED 2026-09-08. It is now a STARTUP ERROR naming the
#                replacement, not a fallback: a deployment that was never
#                repointed carries well-formed settings addressing a
#                resource that no longer exists, and without the hard
#                failure it would start cleanly and die at first query with
#                a connection error. The same applies to any leftover
#                AZURE_FOUNDRY_* variable.
# =============================================================================

# Options: bedrock | vllm | anthropic
LLM_BACKEND=bedrock

# Primary backend URL — only used when LLM_BACKEND=vllm. Ignored under the
# production default. Empty by default: `http://vllm:8000` named the compose
# service deleted on 2026-07-30. Set it only if you run an OpenAI-compatible
# endpoint. Note that Bedrock has no base URL at all — boto3 resolves the
# endpoint from the region, and settings.effective_llm_url RAISES for that
# backend by design.
LLM_PRIMARY_URL=
LLM_PRIMARY_MODEL=Qwen/Qwen3-14B-AWQ

# ── Amazon Bedrock ─────────────────────────────────────────────────────
# No key and no endpoint. The ECS task role authenticates every call with
# SigV4, so there is nothing here to rotate and nothing to leak.
#
# Region is separate from the rest of the stack's because the Bedrock model
# catalogue varies by region, and the models this deployment needs may not
# live where the services do. Confirming that is step 0 of the migration
# (deploy/aws/README.md).
BEDROCK_REGION=us-east-1

# Cohere Command A+. Bedrock's SERVERLESS Cohere generative catalogue is
# Command R/R+ (legacy), which is not the model this deployment runs, so
# this is the ARN of a Bedrock Marketplace / SageMaker-managed endpoint.
#
# ⚠️ That endpoint bills for as long as it EXISTS — there is no idle state.
# The nightly sweeps delete it and recreate it each morning
# (deploy/aws/scheduler/). A failed recreate means no chat at all, with no
# invocation metric to alarm on, which is why the startup sweep waits for
# InService and the BEDROCK_ENDPOINT_NOT_INSERVICE marker is Sev 1.
BEDROCK_CHAT_MODEL_ID=CHANGE_ME_VAULT_REFERENCE

# Context window ceiling — 128K in / 64K out for Cohere Command A+. Must
# match reality or requests near the ceiling get 400s from Bedrock instead
# of clean local truncation.
BEDROCK_CHAT_MAX_MODEL_LEN=128000
BEDROCK_CHAT_MAX_TOKENS=4096

# A Marketplace endpoint the nightly sweep has just recreated is cold, not
# broken, on its first call. This is the ceiling before that counts as a
# failure rather than a slow start.
BEDROCK_CHAT_COLD_START_TIMEOUT_S=120

# Anthropic fallback (optional — leave empty if not using)
ANTHROPIC_API_KEY=CHANGE_ME_VAULT_REFERENCE
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_ENABLE_PROMPT_CACHING=true
ANTHROPIC_USE_PRIORITY_TIER=false

# Model tier aliases for FastAPI orchestrator: none today. MODEL_TIER_FAST
# was removed 2026-09-07 with its only reader, app/agent/llm_classifier.py.
# Settings sets extra="forbid", so a stale key here is a startup crash.

# Context budget. MAX_CONTEXT_TOKENS below is the vLLM-path budget ONLY —
# app/config.py's effective_max_context_tokens property ignores it entirely
# under LLM_BACKEND=bedrock and uses MAX_CONTEXT_TOKENS_BEDROCK instead
# (code default 100_000, sized for Cohere Command A+'s 128K window with
# headroom for output + reasoning + system prompt). Override it here only
# if you have measured a reason to.
MAX_CONTEXT_TOKENS=22000
# MAX_CONTEXT_TOKENS_BEDROCK=100000

# Per-category row caps inside _build_context — these are NOT token counts,
# they cap how many collars/chunks/entities/records get pulled into the
# prompt regardless of backend, and directly drive per-query token cost on
# pay-per-token billing. Left at the original A4500-tuned values;
# there's no golden-set evidence a bigger context window should mean
# stuffing in more retrieved rows — retune deliberately (with a golden-set
# recall/MRR comparison) rather than raising these just because the model
# window got bigger.
MAX_CONTEXT_COLLARS=20
MAX_CONTEXT_DOC_CHUNKS=5
MAX_CONTEXT_GRAPH_ENTITIES=20
MAX_CONTEXT_PG_RECORDS=12

# RAG retrieval quality gate: reject below this score rather than prompting LLM
# with low-quality context. Matches Section 04i hallucination prevention.
RETRIEVAL_QUALITY_THRESHOLD=0.6

# Citation span resolver — the live Azure deployment did NOT set this var
# at all and runs on config.py's own default (false); this file's previous
# "must be true in production" comment didn't match verified live behavior
# (dash-form [DATA-N] citations, confirmed via a real smoke-tested answer).
# Needs senior-reviewer approval before flipping — see config.py.
CITATION_SPAN_RESOLVER_ENABLED=false

# Qwen thinking mode — only relevant when LLM_BACKEND=vllm (Cohere Command A+
# has no equivalent reasoning-trace toggle).
ENABLE_THINKING=false


# =============================================================================
# RERANKER / EMBEDDING BACKENDS — fastapi, hatchet-worker
#
# Both default to `bedrock` in code since 2026-09-08 (ADR-0022), so an unset
# variable selects the hosted backend rather than a self-hosted model host
# that does not exist in production. Set them explicitly anyway.
#
# EMBEDDING_BACKEND must be set IDENTICALLY on both the fastapi (query path)
# and hatchet-worker (ingestion path, passage_embedder.py) tasks. A mismatch
# writes one vector space and queries another, and nothing detects it.
#
# `foundry` is retired: it is now a hard error naming the replacement, not a
# fallback, because falling through would reach a sidecar that is not
# deployed and the query path would retrieve nothing while reporting
# success.
#
# SPLADE++ sparse retrieval has no hosted equivalent — not on Foundry, not
# on Bedrock, not on Cohere's own API. It is self-hosted or the sparse leg
# of hybrid retrieval does not exist (ADR-0022 decision 4).
# =============================================================================

# RERANKER_BACKEND options: bedrock (default) | cross_encoder (self-hosted)
# | qwen3_causal (opt-in, not validated for prod).
#
# ⚠️ VERSION REGRESSION. Foundry served Cohere Rerank **v4**; Bedrock's
# catalogue is Rerank **3.5**. RERANKER_SCORE_THRESHOLD_HOSTED (0.2, renamed
# from _FOUNDRY) was measured against v4 on 2026-08-15 and is the ONLY
# retrieval-quality gate in the system. Re-measure it on the golden set;
# too low and it stops filtering, too high and the refusal rate climbs, and
# neither shows up in any metric anything scrapes.
RERANKER_BACKEND=bedrock
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
# Per-call timeout, clamped at construction to half the reranker's total
# budget (derived from settings.TIMEOUT_RERANKER_S), so it cannot again be
# set to a value that leaves no room for a retry — an 8.0s call timeout
# under an 8.0s wait_for is how every throttle silently degraded retrieval
# to raw Qdrant fusion ordering until 2026-08-20.
BEDROCK_RERANK_TIMEOUT_S=8.0
# Interactive retry profile, deliberately tighter than the ingestion
# ceiling of 4. Someone waiting on a chat answer would rather have
# slightly-worse ordering in two seconds than perfect ordering in forty.
# botocore's adaptive mode supplies the delays.
BEDROCK_RERANK_MAX_ATTEMPTS=3

# ── Remote OCR: Cohere Parse 5 (ADR-0019; on Bedrock since ADR-0022) ──────
# OCR_ENGINE still says `cohere_parse`: the MODEL did not change, only the
# host. Bedrock's serverless catalogue carries no Parse model at all, so
# BEDROCK_PARSE_MODEL_ID is a Marketplace endpoint ARN — and like the chat
# endpoint it bills while it exists and is cycled nightly.
#
# Must be set on the hatchet worker, which is where the parser runs.
OCR_ENGINE=cohere_parse
BEDROCK_PARSE_MODEL_ID=CHANGE_ME_VAULT_REFERENCE
COHERE_PARSE_TIMEOUT_S=120
# Set from ops/validation/bedrock_probe.py once the live cap is known. The
# Parse wire contract has NEVER been empirically verified — that was true on
# Foundry and is still true on Bedrock.
COHERE_PARSE_MAX_PIXELS=4000000
COHERE_PARSE_OUTPUT_FORMAT=blocks
COHERE_PARSE_INCLUDE_IMAGE_DESCRIPTIONS=0
# Pages rendered together and posted concurrently as one group. 1 disables.
OCR_PAGES_PER_BATCH=8
# Per-document cap on pages sent to Parse; the rest go to tesseract.
OCR_MAX_PAGES_PER_DOC=300

# OCR review-routing thresholds. Unset = every OCR page fails closed to
# review_required (and its passages to low_confidence). These values are
# the hand-picked, UNCALIBRATED set docker-compose ships — see the long
# note in .env.example. The cohere_parse block keeps Parse pages (which
# report no confidence) in spot_check: queued for a human sample, but NOT
# demoted in retrieval. Replace with a calibrated set (calibrated_from=...)
# once ~200 Parse pages have been hand-labelled.
OCR_ROUTING_THRESHOLDS_JSON={"catastrophic_max_mean_confidence":0.30,"catastrophic_max_coverage_ratio":0.20,"mandatory_min_mean_confidence":0.60,"mandatory_min_median_confidence":0.60,"mandatory_max_low_confidence_word_ratio":0.40,"mandatory_min_coverage_ratio":0.50,"mandatory_max_gibberish_word_ratio":0.30,"mandatory_max_repeated_character_ratio":0.20,"mandatory_max_seam_duplicate_ratio":0.20,"spot_check_min_mean_confidence":0.90,"spot_check_min_median_confidence":0.90,"spot_check_max_low_confidence_word_ratio":0.10,"spot_check_min_coverage_ratio":0.80,"spot_check_max_gibberish_word_ratio":0.10,"spot_check_max_repeated_character_ratio":0.05,"spot_check_max_seam_duplicate_ratio":0.05,"by_ocr_method":{"cohere_parse":{"floor_tier":"spot_check"}}}

# Chunk sizing. Raised from 1500/200 (sized for bge-small, two embedding
# backends ago). Chunk boundaries are decided at PARSE time, so changing
# these requires RE-INGESTING documents, not just re-embedding them.
PDF_CHUNK_WINDOW_CHARS=5000
PDF_CHUNK_OVERLAP_CHARS=500

# EMBEDDING_BACKEND options: bedrock (default, Cohere Embed v4) | local
# (self-hosted). output_dimension=1024 matches the existing georag_chunks
# Qdrant collection exactly (Matryoshka truncation — Embed v4 supports
# 256/512/1024/1536), so there is no Qdrant schema migration.
#
# Switching backends normally forces a full re-embed of the corpus — dims
# matching does not make two models' vector spaces the same — and
# scripts/reset_embeddings_for_reencode.py is the tool. The 2026-09-08 move
# is the one time that did not apply: there was no corpus to preserve, so
# the collection was simply recreated.
#
# See app/services/embedding.py and app/services/ingest/passage_embedder.py.
EMBEDDING_BACKEND=bedrock
BEDROCK_EMBED_MODEL_ID=cohere.embed-v4:0
BEDROCK_EMBED_DIMENSION=1024
BEDROCK_EMBED_TIMEOUT_S=30


# =============================================================================
# vLLM — OpenAI-compatible GPU inference server (OPTIONAL, LLM_BACKEND=vllm only)
# Applies to: fastapi
#
# The local `vllm` compose service was removed 2026-07-30. These settings
# only matter if you operate your own external OpenAI-compatible endpoint
# and set LLM_BACKEND=vllm to point at it — e.g. an air-gapped on-prem
# deployment with no path to a hosted model. Leave at defaults (unused)
# under LLM_BACKEND=bedrock.
# =============================================================================

# Internal/external URL FastAPI reaches your OpenAI-compatible endpoint at.
# Required when LLM_BACKEND=vllm — FastAPI refuses to start without it.
VLLM_URL=
VLLM_MODEL=Qwen/Qwen3-14B-AWQ

# Quantization kernel selector the endpoint was served with (informational —
# only used by FastAPI to size context budgets, not passed to the endpoint).
VLLM_QUANTIZATION=awq_marlin

# Maximum sequence length (prompt + completion, in tokens) your endpoint
# was started with. Must match reality or requests near the ceiling fail.
VLLM_MAX_MODEL_LEN=8192

# Fraction of GPU VRAM the endpoint may use — informational only if you do
# not operate the GPU host directly from this compose file.
VLLM_GPU_MEM_UTIL=0.92

# HuggingFace access token — only needed if your externally-operated
# endpoint pulls gated repos at your direction; unused otherwise.
HF_TOKEN=


# =============================================================================
# LARAVEL REVERB — WebSocket server
# React clients connect to Reverb for real-time LLM token streaming.
# =============================================================================

REVERB_APP_ID=georag-app
# Generate: openssl rand -base64 32
REVERB_APP_KEY=CHANGE_ME_VAULT_REFERENCE
REVERB_APP_SECRET=CHANGE_ME_VAULT_REFERENCE

REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_HOST_PORT=8080
# Production: use wss (TLS-terminated by nginx/Traefik in front of Reverb)
REVERB_SCHEME=https

# REQUIRED. Both default to 10000 bytes in config/reverb.php, which is far
# too small for a completed LLM answer frame: Reverb silently rejects any
# broadcast payload over the cap, so the chat stream's final "completed"
# frame -- the one carrying the answer text and its citations -- never
# reaches the browser and the stream appears to stall on the last token.
#
# .env.example has carried both at 1000000 with that warning since the day
# it was diagnosed; this file did not, so a deployment provisioned from THIS
# template shipped with the bug. Raise both together: the first is the
# server's cap on the events-API request Laravel publishes through, the
# second is the per-app cap.
REVERB_MAX_REQUEST_SIZE=1000000
REVERB_APP_MAX_MESSAGE_SIZE=1000000

# Frontend Vite variables — must match Reverb settings above
VITE_REVERB_APP_KEY=CHANGE_ME_VAULT_REFERENCE
VITE_REVERB_HOST=your-georag-domain.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=wss

# V1.5-12 — Map base layers (DEM + satellite). On-prem deployments MUST set
# both to self-hosted endpoints (no external CDN dependency). The empty
# default falls back to public CDN — acceptable for connected deployments
# but a privacy/availability concern for air-gapped sites.
# Procedure: ops/runbooks/dem-self-host.md.
VITE_DEM_TILES_URL=https://tiles.your-georag-domain.example.com/dem/tilejson.json
VITE_SATELLITE_TILES_URL=https://tiles.your-georag-domain.example.com/sat/{z}/{y}/{x}.jpg


# =============================================================================
# KESTRA_FLOW_JWT_SECRET — naming leftover, NOT dead
#
# Kestra itself (+ its Caddy edge proxy, + the KestraSsoController wiring
# that needed KESTRA_PG_PASSWORD/KESTRA_BASIC_AUTH_*) was fully removed —
# those required `${VAR:?...}` vars were confirmed to have zero PHP/Python
# consumers and deleted from docker-compose.yml directly (2026-07-31).
# This one var is different: app/routers/integrations_trigger.py still
# actively uses it for a generic external-trigger JWT check — it just
# kept its Kestra-era name after the integration it was built for was
# retired. Real secret, still required by fastapi/hatchet-worker.
# =============================================================================

KESTRA_FLOW_JWT_SECRET=CHANGE_ME_VAULT_REFERENCE

# REQUIRED. pgcrypto key used to decrypt the per-flow JWT signing keys in
# workflow.flow_registry and the per-sender HMAC registry, and to encrypt
# audit PII at rest. 32-byte minimum. Rotating it is a runbook procedure
# (docs/RUNBOOK.md), not an edit -- existing ciphertext must be re-wrapped.
AUDIT_ENCRYPTION_KEY=CHANGE_ME_VAULT_REFERENCE

# REQUIRED. HMAC-SHA256 secret senders sign the canonical JSON payload with
# for the external_notification workflow. Must match on the sender side.
EXTERNAL_NOTIFICATION_HMAC_SECRET=CHANGE_ME_VAULT_REFERENCE

# REQUIRED. Hatchet client auth token -- a JWT minted for the tenant by
# `hatchet-admin token create`. Without it the worker cannot connect and
# NOTHING ingests: no PDF, no drill data, no scheduled maintenance.
HATCHET_CLIENT_TOKEN=CHANGE_ME_VAULT_REFERENCE


# =============================================================================
# LARAVEL FILESYSTEM / MAIL (framework wiring)
# =============================================================================

FILESYSTEM_DISK=s3
MAIL_MAILER=smtp


# =============================================================================
# HATCHET ENGINE — production hardening (added 2026-06-23 sweep)
# These three flags MUST be flipped from their dev defaults ("t") before
# any public exposure. The dev compose default is "t" for local-loop
# convenience; production gets the secure values via this file. The
# operator preflight (scripts/operator/preflight.sh) should assert all
# three are "f" before cd.yml is allowed to deploy.
# =============================================================================

# Send Set-Cookie with Secure flag (requires HTTPS termination upstream).
HATCHET_AUTH_COOKIE_INSECURE=f

# Reject plaintext gRPC; require TLS to hatchet-lite:7077. Pair with
# HATCHET_CLIENT_TLS_STRATEGY=tls (or mtls) on the worker side.
HATCHET_GRPC_INSECURE=f

# Stop auto-marking new accounts as email-verified — make signup go
# through the proper verification flow.
HATCHET_AUTH_SET_EMAIL_VERIFIED=f
