{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bash scripts/guard-build-perms.sh && vite build",
        "build:ssr": "bash scripts/guard-build-perms.sh && vite build --ssr",
        "build:fix-perms": "bash scripts/guard-build-perms.sh --fix",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css"
    },
    "dependencies": {
        "@fontsource/inter-tight": "^5.2.7",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@inertiajs/react": "^3.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "jszip": "^3.10.1",
        "laravel-echo": "^2.3.4",
        "maplibre-gl": "^6.11.2",
        "plotly.js-dist-min": "^3.5.0",
        "proj4": "^2.20.8",
        "pusher-js": "^8.5.0",
        "radix-ui": "^1.4.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-plotly.js": "^4.0.0",
        "tailwind-merge": "^3.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/geojson": "^7946.0.16",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@typescript/typescript6": "^6.0.2",
        "@vitejs/plugin-react": "^6.0.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.4"
    },
    "overrides": {
        "typescript": "$typescript"
    }
}
